<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definicoes_02-entrada-e-saida-de-turma" targetNamespace="https://menteup.umc.br/bpmn"
                  exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_02-entrada-e-saida-de-turma">
    <bpmn:participant id="Participante_02-entrada-e-saida-de-turma" name="MenteUp — Entrada e saída de turma" processRef="Processo_02-entrada-e-saida-de-turma" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_02-entrada-e-saida-de-turma" isExecutable="false">
    <bpmn:laneSet id="Raias_02-entrada-e-saida-de-turma">
      <bpmn:lane id="R_Aluno" name="Aluno">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Escolher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Matriculado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PedirEntrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PedirSair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Nao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Atualizada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Recusado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="R_Sistema" name="Sistema MenteUp">
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recusar409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Atualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MarcarRecusado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AtualizarDireto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="R_Professor" name="Professor da turma ou Administrador">
        <bpmn:flowNodeRef>Analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Aprovar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inicio_Direto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Direto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Direto</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Acessar Turmas">
      <bpmn:outgoing>Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Escolher" name="Escolher a turma">
      <bpmn:incoming>Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Matriculado" name="Já está na turma?">
      <bpmn:incoming>Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>Fluxo_3</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PedirEntrar" name="Pedir para entrar">
      <bpmn:incoming>Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PedirSair" name="Pedir para sair">
      <bpmn:incoming>Fluxo_4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Registrar" name="Validar e registrar pedido PENDENTE">
      <bpmn:incoming>Fluxo_5</bpmn:incoming>
      <bpmn:incoming>Fluxo_6</bpmn:incoming>
      <bpmn:outgoing>Fluxo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Valido" name="Pedido válido?">
      <bpmn:incoming>Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>Fluxo_8</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Recusar409" name="Avisar o motivo (já tem pedido aberto, já está na turma...)">
      <bpmn:incoming>Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Nao" name="Pedido não enviado">
      <bpmn:incoming>Fluxo_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Analisar" name="Analisar o pedido no detalhe da turma">
      <bpmn:incoming>Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>Fluxo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Aprovar" name="Aprovar?">
      <bpmn:incoming>Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_12</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Atualizar" name="Incluir ou retirar o aluno e registrar no log">
      <bpmn:incoming>Fluxo_12</bpmn:incoming>
      <bpmn:outgoing>Fluxo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="MarcarRecusado" name="Marcar pedido como RECUSADO">
      <bpmn:incoming>Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>Fluxo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Atualizada" name="Turma atualizada para o aluno">
      <bpmn:incoming>Fluxo_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fim_Recusado" name="Pedido recusado">
      <bpmn:incoming>Fluxo_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Inicio_Direto" name="Gerenciar alunos da turma">
      <bpmn:outgoing>Fluxo_16</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Direto" name="Adicionar ou remover aluno diretamente">
      <bpmn:incoming>Fluxo_16</bpmn:incoming>
      <bpmn:outgoing>Fluxo_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="AtualizarDireto" name="Atualizar matrícula (só o professor da turma ou admin)">
      <bpmn:incoming>Fluxo_17</bpmn:incoming>
      <bpmn:outgoing>Fluxo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Direto" name="Matrícula atualizada">
      <bpmn:incoming>Fluxo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_1" sourceRef="Inicio" targetRef="Escolher" />
    <bpmn:sequenceFlow id="Fluxo_2" sourceRef="Escolher" targetRef="G_Matriculado" />
    <bpmn:sequenceFlow id="Fluxo_3" name="Não" sourceRef="G_Matriculado" targetRef="PedirEntrar" />
    <bpmn:sequenceFlow id="Fluxo_4" name="Sim" sourceRef="G_Matriculado" targetRef="PedirSair" />
    <bpmn:sequenceFlow id="Fluxo_5" sourceRef="PedirEntrar" targetRef="Registrar" />
    <bpmn:sequenceFlow id="Fluxo_6" sourceRef="PedirSair" targetRef="Registrar" />
    <bpmn:sequenceFlow id="Fluxo_7" sourceRef="Registrar" targetRef="G_Valido" />
    <bpmn:sequenceFlow id="Fluxo_8" name="Sim" sourceRef="G_Valido" targetRef="Analisar" />
    <bpmn:sequenceFlow id="Fluxo_9" name="Não" sourceRef="G_Valido" targetRef="Recusar409" />
    <bpmn:sequenceFlow id="Fluxo_10" sourceRef="Recusar409" targetRef="Fim_Nao" />
    <bpmn:sequenceFlow id="Fluxo_11" sourceRef="Analisar" targetRef="G_Aprovar" />
    <bpmn:sequenceFlow id="Fluxo_12" name="Sim" sourceRef="G_Aprovar" targetRef="Atualizar" />
    <bpmn:sequenceFlow id="Fluxo_13" name="Não" sourceRef="G_Aprovar" targetRef="MarcarRecusado" />
    <bpmn:sequenceFlow id="Fluxo_14" sourceRef="Atualizar" targetRef="Fim_Atualizada" />
    <bpmn:sequenceFlow id="Fluxo_15" sourceRef="MarcarRecusado" targetRef="Fim_Recusado" />
    <bpmn:sequenceFlow id="Fluxo_16" sourceRef="Inicio_Direto" targetRef="Direto" />
    <bpmn:sequenceFlow id="Fluxo_17" sourceRef="Direto" targetRef="AtualizarDireto" />
    <bpmn:sequenceFlow id="Fluxo_18" sourceRef="AtualizarDireto" targetRef="Fim_Direto" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>O aluno pode cancelar o pedido enquanto ele estiver PENDENTE.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
