<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_02-entrada-e-saida-de-turma" targetNamespace="https://menteup.umc.br/bpmn" exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_02-entrada-e-saida-de-turma">
    <bpmn:participant id="Participante_02-entrada-e-saida-de-turma" name="MenteUp — Turmas: entrada, saída e arquivamento" processRef="Processo_02-entrada-e-saida-de-turma" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_02-entrada-e-saida-de-turma" isExecutable="false">
    <bpmn:laneSet id="Raias_02-entrada-e-saida-de-turma">
      <bpmn:lane id="R_Aluno_02" name="Aluno"><bpmn:flowNodeRef>Inicio_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Escolher_02</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Matriculado_02</bpmn:flowNodeRef><bpmn:flowNodeRef>PedirEntrar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>PedirSair_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Nao_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Atualizada_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Recusado_02</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Sistema_02" name="Sistema MenteUp"><bpmn:flowNodeRef>Registrar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Valido_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Recusar409_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Atualizar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>MarcarRecusado_02</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Historico_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Apagar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Explicar_02</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Professor_02" name="Professor da turma ou Administrador"><bpmn:flowNodeRef>Analisar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Aprovar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Inicio_Gestao_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Criar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Direto_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Excluir_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Arquivar_02</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Gestao_02</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_02" name="Acessar Turmas"><bpmn:outgoing>Fluxo_1_02</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Escolher_02" name="Escolher a turma"><bpmn:incoming>Fluxo_1_02</bpmn:incoming><bpmn:outgoing>Fluxo_2_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Matriculado_02" name="Já está na turma?"><bpmn:incoming>Fluxo_2_02</bpmn:incoming><bpmn:outgoing>Fluxo_3_02</bpmn:outgoing><bpmn:outgoing>Fluxo_4_02</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="PedirEntrar_02" name="Pedir para entrar"><bpmn:incoming>Fluxo_3_02</bpmn:incoming><bpmn:outgoing>Fluxo_5_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="PedirSair_02" name="Pedir para sair"><bpmn:incoming>Fluxo_4_02</bpmn:incoming><bpmn:outgoing>Fluxo_6_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Registrar_02" name="Validar e registrar o pedido PENDENTE"><bpmn:incoming>Fluxo_5_02</bpmn:incoming><bpmn:incoming>Fluxo_6_02</bpmn:incoming><bpmn:outgoing>Fluxo_7_02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Valido_02" name="Pedido válido?"><bpmn:incoming>Fluxo_7_02</bpmn:incoming><bpmn:outgoing>Fluxo_8_02</bpmn:outgoing><bpmn:outgoing>Fluxo_9_02</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Recusar409_02" name="Avisar o motivo (pedido aberto, turma arquivada...)"><bpmn:incoming>Fluxo_9_02</bpmn:incoming><bpmn:outgoing>Fluxo_10_02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Nao_02" name="Pedido não enviado"><bpmn:incoming>Fluxo_10_02</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Analisar_02" name="Analisar o pedido no detalhe da turma"><bpmn:incoming>Fluxo_8_02</bpmn:incoming><bpmn:outgoing>Fluxo_11_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Aprovar_02" name="Aprovar?"><bpmn:incoming>Fluxo_11_02</bpmn:incoming><bpmn:outgoing>Fluxo_12_02</bpmn:outgoing><bpmn:outgoing>Fluxo_13_02</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Atualizar_02" name="Incluir ou retirar o aluno e registrar no log"><bpmn:incoming>Fluxo_12_02</bpmn:incoming><bpmn:outgoing>Fluxo_14_02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="MarcarRecusado_02" name="Marcar o pedido como RECUSADO"><bpmn:incoming>Fluxo_13_02</bpmn:incoming><bpmn:outgoing>Fluxo_15_02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Atualizada_02" name="Turma atualizada para o aluno"><bpmn:incoming>Fluxo_14_02</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="Fim_Recusado_02" name="Pedido recusado"><bpmn:incoming>Fluxo_15_02</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Inicio_Gestao_02" name="Gerenciar turmas"><bpmn:outgoing>Fluxo_16_02</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Criar_02" name="Criar a turma (o admin escolhe o professor responsável)"><bpmn:incoming>Fluxo_16_02</bpmn:incoming><bpmn:outgoing>Fluxo_17_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Direto_02" name="Adicionar alunos pelo e-mail ou remover"><bpmn:incoming>Fluxo_17_02</bpmn:incoming><bpmn:outgoing>Fluxo_18_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Excluir_02" name="Pedir para excluir a turma"><bpmn:incoming>Fluxo_18_02</bpmn:incoming><bpmn:outgoing>Fluxo_19_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Historico_02" name="Tem alunos ou histórico?"><bpmn:incoming>Fluxo_19_02</bpmn:incoming><bpmn:outgoing>Fluxo_20_02</bpmn:outgoing><bpmn:outgoing>Fluxo_21_02</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Apagar_02" name="Excluir a turma e registrar no log"><bpmn:incoming>Fluxo_20_02</bpmn:incoming><bpmn:outgoing>Fluxo_24_02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Explicar_02" name="Explicar o motivo e oferecer o arquivamento"><bpmn:incoming>Fluxo_21_02</bpmn:incoming><bpmn:outgoing>Fluxo_22_02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Arquivar_02" name="Arquivar (some das listas, histórico mantido)"><bpmn:incoming>Fluxo_22_02</bpmn:incoming><bpmn:outgoing>Fluxo_23_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="Fim_Gestao_02" name="Turma organizada"><bpmn:incoming>Fluxo_23_02</bpmn:incoming><bpmn:incoming>Fluxo_24_02</bpmn:incoming></bpmn:endEvent>
