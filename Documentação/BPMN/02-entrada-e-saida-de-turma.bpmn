    <bpmn:textAnnotation id="Nota_1_02"><bpmn:text>O aluno pode cancelar o pedido enquanto ele estiver PENDENTE.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Nota_1_02" sourceRef="PedirEntrar_02" targetRef="Nota_1_02" />
    <bpmn:textAnnotation id="Nota_2_02"><bpmn:text>O professor só gerencia as turmas dele; o administrador, todas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Nota_2_02" sourceRef="Direto_02" targetRef="Nota_2_02" />
  </bpmn:process>
