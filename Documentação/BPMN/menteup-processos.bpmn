    <bpmn:sequenceFlow id="P5_Fluxo_10" sourceRef="P5_Encerrar" targetRef="P5_VerRanking" />
    <bpmn:sequenceFlow id="P5_Fluxo_11" sourceRef="P5_VerRanking" targetRef="P5_Fim" />
  </bpmn:process>
  <bpmn:process id="P6_Processo_05-monitoramento-dashboard-grafana" isExecutable="false">
    <bpmn:laneSet id="P6_Raias_05-monitoramento-dashboard-grafana">
      <bpmn:lane id="P6_R_Admin" name="Administrador">
        <bpmn:flowNodeRef>P6_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Entrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P6_R_Grafana" name="Grafana (plugin Infinity)">
        <bpmn:flowNodeRef>P6_Chamar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Montar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Fim_Erro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P6_R_Api" name="Back-end MenteUp (API /dashboard)">
        <bpmn:flowNodeRef>P6_G_Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Negar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_Calcular</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P6_Inicio" name="Acompanhar indicadores">
      <bpmn:outgoing>P6_Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P6_Entrar" name="Entrar no Grafana como admin (localhost:3001)">
      <bpmn:incoming>P6_Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P6_Chamar" name="Chamar a API com o token X-Dashboard-Token">
      <bpmn:incoming>P6_Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P6_G_Token" name="Token válido?">
      <bpmn:incoming>P6_Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_4</bpmn:outgoing>
      <bpmn:outgoing>P6_Fluxo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P6_Negar" name="Responder 401">
      <bpmn:incoming>P6_Fluxo_5</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P6_Calcular" name="Calcular indicadores agregados (sem dados pessoais)">
      <bpmn:incoming>P6_Fluxo_4</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P6_Montar" name="Montar Big Numbers e gráficos">
      <bpmn:incoming>P6_Fluxo_6</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P6_Analisar" name="Analisar uso e aprendizado da plataforma">
      <bpmn:incoming>P6_Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>P6_Fluxo_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P6_Fim" name="Atualiza a cada 1 minuto">
      <bpmn:incoming>P6_Fluxo_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P6_Fim_Erro" name="Painel com erro">
      <bpmn:incoming>P6_Fluxo_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P6_Fluxo_1" sourceRef="P6_Inicio" targetRef="P6_Entrar" />
    <bpmn:sequenceFlow id="P6_Fluxo_2" sourceRef="P6_Entrar" targetRef="P6_Chamar" />
    <bpmn:sequenceFlow id="P6_Fluxo_3" sourceRef="P6_Chamar" targetRef="P6_G_Token" />
    <bpmn:sequenceFlow id="P6_Fluxo_4" name="Sim" sourceRef="P6_G_Token" targetRef="P6_Calcular" />
    <bpmn:sequenceFlow id="P6_Fluxo_5" name="Não" sourceRef="P6_G_Token" targetRef="P6_Negar" />
    <bpmn:sequenceFlow id="P6_Fluxo_6" sourceRef="P6_Calcular" targetRef="P6_Montar" />
    <bpmn:sequenceFlow id="P6_Fluxo_7" sourceRef="P6_Negar" targetRef="P6_Fim_Erro" />
    <bpmn:sequenceFlow id="P6_Fluxo_8" sourceRef="P6_Montar" targetRef="P6_Analisar" />
    <bpmn:sequenceFlow id="P6_Fluxo_9" sourceRef="P6_Analisar" targetRef="P6_Fim" />
  </bpmn:process>
