<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_menteup-processos" targetNamespace="https://menteup.umc.br/bpmn" exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_menteup-processos">
    <bpmn:participant id="Participante_00-cadastro-de-conta" name="MenteUp — Cadastro de conta e aprovação de professor" processRef="Processo_00-cadastro-de-conta" />
    <bpmn:participant id="Participante_01-acesso-e-recuperacao-de-senha" name="MenteUp — Acesso (2FA), primeiro acesso e recuperação de senha" processRef="Processo_01-acesso-e-recuperacao-de-senha" />
    <bpmn:participant id="Participante_02-entrada-e-saida-de-turma" name="MenteUp — Turmas: entrada, saída e arquivamento" processRef="Processo_02-entrada-e-saida-de-turma" />
    <bpmn:participant id="Participante_03-atividade-desempenho-e-conquistas" name="MenteUp — Atividade, desempenho e conquistas" processRef="Processo_03-atividade-desempenho-e-conquistas" />
    <bpmn:participant id="Participante_04-desafio-ao-vivo" name="MenteUp — Desafio ao vivo" processRef="Processo_04-desafio-ao-vivo" />
    <bpmn:participant id="Participante_05-monitoramento-dashboard-grafana" name="MenteUp — Painel de indicadores e monitoramento no Grafana" processRef="Processo_05-monitoramento-dashboard-grafana" />
    <bpmn:participant id="Participante_06-lgpd-dados-pessoais" name="MenteUp — LGPD: cópia dos dados, exclusão da conta e descarte automático" processRef="Processo_06-lgpd-dados-pessoais" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_00-cadastro-de-conta" isExecutable="false">
    <bpmn:laneSet id="Raias_00-cadastro-de-conta">
      <bpmn:lane id="R_Visitante_00" name="Visitante (novo aluno ou professor)"><bpmn:flowNodeRef>Inicio_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Dados_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Termo_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Aluno_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Aprovado_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Rejeitado_00</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Sistema_00" name="Sistema MenteUp"><bpmn:flowNodeRef>G_Dados_00</bpmn:flowNodeRef><bpmn:flowNodeRef>ErroDados_00</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Email_00</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoEmail_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Salvar_00</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Prof_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Pendente_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Aprovar_00</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejeitar_00</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Admin_00" name="Administrador"><bpmn:flowNodeRef>Analisar_00</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Aprovar_00</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_00" name="Acessar a página de cadastro"><bpmn:outgoing>Fluxo_1_00</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Dados_00" name="Escolher Aluno ou Professor e informar nome, e-mail e senha"><bpmn:incoming>Fluxo_1_00</bpmn:incoming><bpmn:incoming>Fluxo_6_00</bpmn:incoming><bpmn:incoming>Fluxo_9_00</bpmn:incoming><bpmn:outgoing>Fluxo_2_00</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Termo_00" name="Abrir o Termo e a Política e marcar o aceite"><bpmn:incoming>Fluxo_2_00</bpmn:incoming><bpmn:outgoing>Fluxo_3_00</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Dados_00" name="Dados válidos e senha forte?"><bpmn:incoming>Fluxo_3_00</bpmn:incoming><bpmn:outgoing>Fluxo_4_00</bpmn:outgoing><bpmn:outgoing>Fluxo_5_00</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ErroDados_00" name="Mostrar o erro e os requisitos da senha"><bpmn:incoming>Fluxo_5_00</bpmn:incoming><bpmn:outgoing>Fluxo_6_00</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Email_00" name="E-mail já cadastrado?"><bpmn:incoming>Fluxo_4_00</bpmn:incoming><bpmn:outgoing>Fluxo_7_00</bpmn:outgoing><bpmn:outgoing>Fluxo_8_00</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoEmail_00" name="Avisar que o e-mail já está cadastrado"><bpmn:incoming>Fluxo_8_00</bpmn:incoming><bpmn:outgoing>Fluxo_9_00</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Salvar_00" name="Criptografar a senha (BCrypt), registrar o aceite e salvar"><bpmn:incoming>Fluxo_7_00</bpmn:incoming><bpmn:outgoing>Fluxo_10_00</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Prof_00" name="É professor?"><bpmn:incoming>Fluxo_10_00</bpmn:incoming><bpmn:outgoing>Fluxo_11_00</bpmn:outgoing><bpmn:outgoing>Fluxo_12_00</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fim_Aluno_00" name="Conta de aluno criada: seguir para o login"><bpmn:incoming>Fluxo_11_00</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Pendente_00" name="Marcar o cadastro como PENDENTE"><bpmn:incoming>Fluxo_12_00</bpmn:incoming><bpmn:outgoing>Fluxo_13_00</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Analisar_00" name="Analisar o pedido em Usuários"><bpmn:incoming>Fluxo_13_00</bpmn:incoming><bpmn:outgoing>Fluxo_14_00</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Aprovar_00" name="Aprovar?"><bpmn:incoming>Fluxo_14_00</bpmn:incoming><bpmn:outgoing>Fluxo_15_00</bpmn:outgoing><bpmn:outgoing>Fluxo_16_00</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Aprovar_00" name="Marcar APROVADA e avisar o professor por e-mail"><bpmn:incoming>Fluxo_15_00</bpmn:incoming><bpmn:outgoing>Fluxo_17_00</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="Rejeitar_00" name="Marcar REJEITADA e avisar o professor por e-mail"><bpmn:incoming>Fluxo_16_00</bpmn:incoming><bpmn:outgoing>Fluxo_18_00</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="Fim_Aprovado_00" name="Professor liberado para o login"><bpmn:incoming>Fluxo_17_00</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="Fim_Rejeitado_00" name="Pode enviar um novo pedido"><bpmn:incoming>Fluxo_18_00</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_1_00" sourceRef="Inicio_00" targetRef="Dados_00" />
    <bpmn:sequenceFlow id="Fluxo_2_00" sourceRef="Dados_00" targetRef="Termo_00" />
    <bpmn:sequenceFlow id="Fluxo_3_00" sourceRef="Termo_00" targetRef="G_Dados_00" />
    <bpmn:sequenceFlow id="Fluxo_4_00" name="Sim" sourceRef="G_Dados_00" targetRef="G_Email_00" />
    <bpmn:sequenceFlow id="Fluxo_5_00" name="Não" sourceRef="G_Dados_00" targetRef="ErroDados_00" />
    <bpmn:sequenceFlow id="Fluxo_6_00" sourceRef="ErroDados_00" targetRef="Dados_00" />
    <bpmn:sequenceFlow id="Fluxo_7_00" name="Não" sourceRef="G_Email_00" targetRef="Salvar_00" />
    <bpmn:sequenceFlow id="Fluxo_8_00" name="Sim" sourceRef="G_Email_00" targetRef="AvisoEmail_00" />
    <bpmn:sequenceFlow id="Fluxo_9_00" sourceRef="AvisoEmail_00" targetRef="Dados_00" />
    <bpmn:sequenceFlow id="Fluxo_10_00" sourceRef="Salvar_00" targetRef="G_Prof_00" />
    <bpmn:sequenceFlow id="Fluxo_11_00" name="Não" sourceRef="G_Prof_00" targetRef="Fim_Aluno_00" />
    <bpmn:sequenceFlow id="Fluxo_12_00" name="Sim" sourceRef="G_Prof_00" targetRef="Pendente_00" />
    <bpmn:sequenceFlow id="Fluxo_13_00" sourceRef="Pendente_00" targetRef="Analisar_00" />
    <bpmn:sequenceFlow id="Fluxo_14_00" sourceRef="Analisar_00" targetRef="G_Aprovar_00" />
    <bpmn:sequenceFlow id="Fluxo_15_00" name="Sim" sourceRef="G_Aprovar_00" targetRef="Aprovar_00" />
    <bpmn:sequenceFlow id="Fluxo_16_00" name="Não" sourceRef="G_Aprovar_00" targetRef="Rejeitar_00" />
    <bpmn:sequenceFlow id="Fluxo_17_00" sourceRef="Aprovar_00" targetRef="Fim_Aprovado_00" />
    <bpmn:sequenceFlow id="Fluxo_18_00" sourceRef="Rejeitar_00" targetRef="Fim_Rejeitado_00" />
    <bpmn:textAnnotation id="Nota_1_00"><bpmn:text>O aceite só é liberado depois de abrir os dois documentos.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Nota_1_00" sourceRef="Termo_00" targetRef="Nota_1_00" />
  </bpmn:process>
  <bpmn:process id="Processo_01-acesso-e-recuperacao-de-senha" isExecutable="false">
    <bpmn:laneSet id="Raias_01-acesso-e-recuperacao-de-senha">
      <bpmn:lane id="R_Usuario_01" name="Usuário (aluno, professor ou administrador)"><bpmn:flowNodeRef>Inicio_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Credenciais_01</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoBloqueio_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Bloq_01</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoStatus_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Status_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Codigo_01</bpmn:flowNodeRef><bpmn:flowNodeRef>NovoAceite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Painel_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Inicio_Rec_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Esqueci_01</bpmn:flowNodeRef><bpmn:flowNodeRef>NovaSenha_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Recuperada_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Inicio_Convite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>PrimeiroAcesso_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Convite_01</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Sistema_01" name="Sistema MenteUp"><bpmn:flowNodeRef>G_Bloqueada_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Senha_01</bpmn:flowNodeRef><bpmn:flowNodeRef>SomarErro_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Terceira_01</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoInvalido_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Bloquear_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Bloqueada_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Status_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Enviar2FA_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Codigo_01</bpmn:flowNodeRef><bpmn:flowNodeRef>ErroCodigo_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Token_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Aceite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Limite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Limite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>EnviarLink_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Desbloquear_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Ativar_01</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_01" name="Acessar o MenteUp"><bpmn:outgoing>Fluxo_1_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Credenciais_01" name="Informar e-mail e senha"><bpmn:incoming>Fluxo_1_01</bpmn:incoming><bpmn:incoming>Fluxo_11_01</bpmn:incoming><bpmn:outgoing>Fluxo_2_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Bloqueada_01" name="Conta bloqueada?"><bpmn:incoming>Fluxo_2_01</bpmn:incoming><bpmn:outgoing>Fluxo_3_01</bpmn:outgoing><bpmn:outgoing>Fluxo_4_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoBloqueio_01" name="Avisar conta bloqueada e indicar &quot;Esqueci minha senha&quot;"><bpmn:incoming>Fluxo_4_01</bpmn:incoming><bpmn:outgoing>Fluxo_5_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Bloq_01" name="Seguir para a recuperação"><bpmn:incoming>Fluxo_5_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Senha_01" name="Senha correta?"><bpmn:incoming>Fluxo_3_01</bpmn:incoming><bpmn:outgoing>Fluxo_6_01</bpmn:outgoing><bpmn:outgoing>Fluxo_7_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SomarErro_01" name="Somar tentativa errada"><bpmn:incoming>Fluxo_7_01</bpmn:incoming><bpmn:outgoing>Fluxo_8_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Terceira_01" name="3ª tentativa seguida?"><bpmn:incoming>Fluxo_8_01</bpmn:incoming><bpmn:outgoing>Fluxo_9_01</bpmn:outgoing><bpmn:outgoing>Fluxo_10_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoInvalido_01" name="Avisar &quot;e-mail ou senha inválidos&quot;"><bpmn:incoming>Fluxo_9_01</bpmn:incoming><bpmn:outgoing>Fluxo_11_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Bloquear_01" name="Bloquear a conta e encerrar as sessões abertas"><bpmn:incoming>Fluxo_10_01</bpmn:incoming><bpmn:outgoing>Fluxo_12_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Bloqueada_01" name="Conta bloqueada"><bpmn:incoming>Fluxo_12_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Status_01" name="Professor pendente ou rejeitado?"><bpmn:incoming>Fluxo_6_01</bpmn:incoming><bpmn:outgoing>Fluxo_13_01</bpmn:outgoing><bpmn:outgoing>Fluxo_14_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoStatus_01" name="Avisar &quot;aguardando aprovação&quot; ou &quot;cadastro rejeitado&quot;"><bpmn:incoming>Fluxo_14_01</bpmn:incoming><bpmn:outgoing>Fluxo_15_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Status_01" name="Acesso não liberado"><bpmn:incoming>Fluxo_15_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="Enviar2FA_01" name="Enviar o código 2FA por e-mail (5 min, guardado em hash)"><bpmn:incoming>Fluxo_13_01</bpmn:incoming><bpmn:outgoing>Fluxo_16_01</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="Codigo_01" name="Informar o código (pode pedir reenvio: até 3, a cada 60 s)"><bpmn:incoming>Fluxo_16_01</bpmn:incoming><bpmn:incoming>Fluxo_20_01</bpmn:incoming><bpmn:outgoing>Fluxo_17_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Codigo_01" name="Código válido?"><bpmn:incoming>Fluxo_17_01</bpmn:incoming><bpmn:outgoing>Fluxo_18_01</bpmn:outgoing><bpmn:outgoing>Fluxo_19_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ErroCodigo_01" name="Contar o erro (após 5, é preciso pedir novo código)"><bpmn:incoming>Fluxo_19_01</bpmn:incoming><bpmn:outgoing>Fluxo_20_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Token_01" name="Gerar o token JWT e registrar LOGIN no log"><bpmn:incoming>Fluxo_18_01</bpmn:incoming><bpmn:outgoing>Fluxo_21_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Aceite_01" name="Aceitou a versão atual do Termo e da Política?"><bpmn:incoming>Fluxo_21_01</bpmn:incoming><bpmn:outgoing>Fluxo_22_01</bpmn:outgoing><bpmn:outgoing>Fluxo_23_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="NovoAceite_01" name="Ler e aceitar a nova versão"><bpmn:incoming>Fluxo_23_01</bpmn:incoming><bpmn:outgoing>Fluxo_24_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="Fim_Painel_01" name="Painel do perfil aberto"><bpmn:incoming>Fluxo_22_01</bpmn:incoming><bpmn:incoming>Fluxo_24_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Inicio_Rec_01" name="Esqueceu a senha ou teve a conta bloqueada"><bpmn:outgoing>Fluxo_25_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Esqueci_01" name="Pedir &quot;Esqueci minha senha&quot; informando o e-mail"><bpmn:incoming>Fluxo_25_01</bpmn:incoming><bpmn:outgoing>Fluxo_26_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Limite_01" name="Dentro do limite de pedidos (IP e e-mail)?"><bpmn:incoming>Fluxo_26_01</bpmn:incoming><bpmn:outgoing>Fluxo_27_01</bpmn:outgoing><bpmn:outgoing>Fluxo_28_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fim_Limite_01" name="Pedido ignorado"><bpmn:incoming>Fluxo_28_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="EnviarLink_01" name="Enviar o link (30 min, uso único); a resposta é igual exista ou não o e-mail"><bpmn:incoming>Fluxo_27_01</bpmn:incoming><bpmn:outgoing>Fluxo_29_01</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="NovaSenha_01" name="Abrir o link e criar uma senha forte"><bpmn:incoming>Fluxo_29_01</bpmn:incoming><bpmn:outgoing>Fluxo_30_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Desbloquear_01" name="Trocar a senha, desbloquear e encerrar as sessões abertas"><bpmn:incoming>Fluxo_30_01</bpmn:incoming><bpmn:outgoing>Fluxo_31_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Recuperada_01" name="Senha redefinida: voltar ao login"><bpmn:incoming>Fluxo_31_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Inicio_Convite_01" name="Receber o convite criado pelo administrador (72 h)"><bpmn:outgoing>Fluxo_32_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="PrimeiroAcesso_01" name="Definir a senha e aceitar o Termo e a Política"><bpmn:incoming>Fluxo_32_01</bpmn:incoming><bpmn:outgoing>Fluxo_33_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Ativar_01" name="Salvar a senha e registrar o aceite"><bpmn:incoming>Fluxo_33_01</bpmn:incoming><bpmn:outgoing>Fluxo_34_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Convite_01" name="Conta ativada: seguir para o login"><bpmn:incoming>Fluxo_34_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_1_01" sourceRef="Inicio_01" targetRef="Credenciais_01" />
    <bpmn:sequenceFlow id="Fluxo_2_01" sourceRef="Credenciais_01" targetRef="G_Bloqueada_01" />
    <bpmn:sequenceFlow id="Fluxo_3_01" name="Não" sourceRef="G_Bloqueada_01" targetRef="G_Senha_01" />
    <bpmn:sequenceFlow id="Fluxo_4_01" name="Sim" sourceRef="G_Bloqueada_01" targetRef="AvisoBloqueio_01" />
    <bpmn:sequenceFlow id="Fluxo_5_01" sourceRef="AvisoBloqueio_01" targetRef="Fim_Bloq_01" />
    <bpmn:sequenceFlow id="Fluxo_6_01" name="Sim" sourceRef="G_Senha_01" targetRef="G_Status_01" />
    <bpmn:sequenceFlow id="Fluxo_7_01" name="Não" sourceRef="G_Senha_01" targetRef="SomarErro_01" />
    <bpmn:sequenceFlow id="Fluxo_8_01" sourceRef="SomarErro_01" targetRef="G_Terceira_01" />
    <bpmn:sequenceFlow id="Fluxo_9_01" name="Não" sourceRef="G_Terceira_01" targetRef="AvisoInvalido_01" />
    <bpmn:sequenceFlow id="Fluxo_10_01" name="Sim" sourceRef="G_Terceira_01" targetRef="Bloquear_01" />
    <bpmn:sequenceFlow id="Fluxo_11_01" sourceRef="AvisoInvalido_01" targetRef="Credenciais_01" />
    <bpmn:sequenceFlow id="Fluxo_12_01" sourceRef="Bloquear_01" targetRef="Fim_Bloqueada_01" />
    <bpmn:sequenceFlow id="Fluxo_13_01" name="Não" sourceRef="G_Status_01" targetRef="Enviar2FA_01" />
    <bpmn:sequenceFlow id="Fluxo_14_01" name="Sim" sourceRef="G_Status_01" targetRef="AvisoStatus_01" />
    <bpmn:sequenceFlow id="Fluxo_15_01" sourceRef="AvisoStatus_01" targetRef="Fim_Status_01" />
