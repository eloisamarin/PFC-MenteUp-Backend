    <bpmn:exclusiveGateway id="G_Senha_06" name="Senha correta?"><bpmn:incoming>Fluxo_6_06</bpmn:incoming><bpmn:outgoing>Fluxo_7_06</bpmn:outgoing><bpmn:outgoing>Fluxo_8_06</bpmn:outgoing></bpmn:exclusiveGateway>
