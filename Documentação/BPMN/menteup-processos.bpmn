<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definicoes_menteup-processos" targetNamespace="https://menteup.umc.br/bpmn"
                  exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_menteup-processos">
    <bpmn:participant id="P1_Participante_00-cadastro-de-conta" name="MenteUp — Cadastro de conta" processRef="P1_Processo_00-cadastro-de-conta" />
    <bpmn:participant id="P2_Participante_01-acesso-e-recuperacao-de-senha" name="MenteUp — Acesso, bloqueio e recuperação de senha" processRef="P2_Processo_01-acesso-e-recuperacao-de-senha" />
    <bpmn:participant id="P3_Participante_02-entrada-e-saida-de-turma" name="MenteUp — Entrada e saída de turma" processRef="P3_Processo_02-entrada-e-saida-de-turma" />
    <bpmn:participant id="P4_Participante_03-atividade-desempenho-e-conquistas" name="MenteUp — Atividade, desempenho e conquistas" processRef="P4_Processo_03-atividade-desempenho-e-conquistas" />
    <bpmn:participant id="P5_Participante_04-desafio-ao-vivo" name="MenteUp — Desafio ao vivo" processRef="P5_Processo_04-desafio-ao-vivo" />
    <bpmn:participant id="P6_Participante_05-monitoramento-dashboard-grafana" name="MenteUp — Monitoramento pela dashboard do Grafana" processRef="P6_Processo_05-monitoramento-dashboard-grafana" />
  </bpmn:collaboration>
  <bpmn:process id="P1_Processo_00-cadastro-de-conta" isExecutable="false">
    <bpmn:laneSet id="P1_Raias_00-cadastro-de-conta">
      <bpmn:lane id="P1_R_Visitante" name="Visitante (novo aluno ou professor)">
        <bpmn:flowNodeRef>P1_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_R_Sistema" name="Sistema MenteUp">
        <bpmn:flowNodeRef>P1_G_Dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_ErroDados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_VerificarEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_G_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_AvisoEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Salvar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_SalvarPerfil</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_R_Admin" name="Administrador">
        <bpmn:flowNodeRef>P1_Inicio_Adm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Alterar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Fim_Adm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_Inicio" name="Acessar a página de cadastro">
      <bpmn:outgoing>P1_Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1_Perfil" name="Escolher o perfil: Aluno ou Professor">
      <bpmn:incoming>P1_Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_Dados" name="Informar nome, e-mail, senha e confirmação">
      <bpmn:incoming>P1_Fluxo_2</bpmn:incoming>
      <bpmn:incoming>P1_Fluxo_6</bpmn:incoming>
      <bpmn:incoming>P1_Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_G_Dados" name="Dados válidos?">
      <bpmn:incoming>P1_Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_4</bpmn:outgoing>
      <bpmn:outgoing>P1_Fluxo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P1_ErroDados" name="Mostrar o erro (campo vazio, senha &lt; 8 ou senhas diferentes)">
      <bpmn:incoming>P1_Fluxo_5</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P1_VerificarEmail" name="Verificar se o e-mail já está cadastrado">
      <bpmn:incoming>P1_Fluxo_4</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P1_G_Email" name="E-mail já existe?">
      <bpmn:incoming>P1_Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_8</bpmn:outgoing>
      <bpmn:outgoing>P1_Fluxo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P1_AvisoEmail" name="Avisar &quot;Este e-mail já está cadastrado&quot;">
      <bpmn:incoming>P1_Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P1_Salvar" name="Criptografar a senha (BCrypt) e salvar o usuário">
      <bpmn:incoming>P1_Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P1_Log" name="Registrar o cadastro no log do sistema">
      <bpmn:incoming>P1_Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P1_Fim" name="Conta criada: seguir para o login (processo 1)">
      <bpmn:incoming>P1_Fluxo_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P1_Inicio_Adm" name="Gerenciar usuários">
      <bpmn:outgoing>P1_Fluxo_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1_Alterar" name="Alterar o perfil de um usuário (ex.: tornar administrador)">
      <bpmn:incoming>P1_Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1_SalvarPerfil" name="Salvar e registrar a troca de permissão no log">
      <bpmn:incoming>P1_Fluxo_14</bpmn:incoming>
      <bpmn:outgoing>P1_Fluxo_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P1_Fim_Adm" name="Perfil atualizado">
      <bpmn:incoming>P1_Fluxo_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_Fluxo_1" sourceRef="P1_Inicio" targetRef="P1_Perfil" />
    <bpmn:sequenceFlow id="P1_Fluxo_2" sourceRef="P1_Perfil" targetRef="P1_Dados" />
    <bpmn:sequenceFlow id="P1_Fluxo_3" sourceRef="P1_Dados" targetRef="P1_G_Dados" />
    <bpmn:sequenceFlow id="P1_Fluxo_4" name="Sim" sourceRef="P1_G_Dados" targetRef="P1_VerificarEmail" />
    <bpmn:sequenceFlow id="P1_Fluxo_5" name="Não" sourceRef="P1_G_Dados" targetRef="P1_ErroDados" />
    <bpmn:sequenceFlow id="P1_Fluxo_6" sourceRef="P1_ErroDados" targetRef="P1_Dados" />
    <bpmn:sequenceFlow id="P1_Fluxo_7" sourceRef="P1_VerificarEmail" targetRef="P1_G_Email" />
    <bpmn:sequenceFlow id="P1_Fluxo_8" name="Não" sourceRef="P1_G_Email" targetRef="P1_Salvar" />
    <bpmn:sequenceFlow id="P1_Fluxo_9" name="Sim" sourceRef="P1_G_Email" targetRef="P1_AvisoEmail" />
    <bpmn:sequenceFlow id="P1_Fluxo_10" sourceRef="P1_AvisoEmail" targetRef="P1_Dados" />
    <bpmn:sequenceFlow id="P1_Fluxo_11" sourceRef="P1_Salvar" targetRef="P1_Log" />
    <bpmn:sequenceFlow id="P1_Fluxo_12" sourceRef="P1_Log" targetRef="P1_Fim" />
    <bpmn:sequenceFlow id="P1_Fluxo_13" sourceRef="P1_Inicio_Adm" targetRef="P1_Alterar" />
    <bpmn:sequenceFlow id="P1_Fluxo_14" sourceRef="P1_Alterar" targetRef="P1_SalvarPerfil" />
    <bpmn:sequenceFlow id="P1_Fluxo_15" sourceRef="P1_SalvarPerfil" targetRef="P1_Fim_Adm" />
    <bpmn:textAnnotation id="P1_Nota_1"><bpmn:text>A tela de cadastro oferece só Aluno ou Professor; só o administrador muda o tipo de usuário.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="P2_Processo_01-acesso-e-recuperacao-de-senha" isExecutable="false">
    <bpmn:laneSet id="P2_Raias_01-acesso-e-recuperacao-de-senha">
      <bpmn:lane id="P2_R_Usuario" name="Usuário (aluno, professor ou administrador)">
        <bpmn:flowNodeRef>P2_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Credenciais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_AvisoInvalido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Codigo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Fim_Painel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Esqueci</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_NovaSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Fim_Recuperada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_R_Sistema" name="Sistema MenteUp">
        <bpmn:flowNodeRef>P2_G_Bloqueada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_G_Senha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_SomarErro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_G_Terceira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Bloquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Enviar2FA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_G_Codigo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_AvisoBloqueio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_EnviarLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Desbloquear</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_Inicio" name="Acessar o MenteUp">
      <bpmn:outgoing>P2_Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2_Credenciais" name="Informar e-mail e senha">
      <bpmn:incoming>P2_Fluxo_1</bpmn:incoming>
      <bpmn:incoming>P2_Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_G_Bloqueada" name="Conta bloqueada?">
      <bpmn:incoming>P2_Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_3</bpmn:outgoing>
      <bpmn:outgoing>P2_Fluxo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P2_G_Senha" name="Senha correta?">
      <bpmn:incoming>P2_Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_5</bpmn:outgoing>
      <bpmn:outgoing>P2_Fluxo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_SomarErro" name="Somar tentativa errada">
      <bpmn:incoming>P2_Fluxo_6</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_G_Terceira" name="3ª tentativa seguida?">
      <bpmn:incoming>P2_Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_8</bpmn:outgoing>
      <bpmn:outgoing>P2_Fluxo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_Bloquear" name="Bloquear a conta">
      <bpmn:incoming>P2_Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_AvisoInvalido" name="Avisar &quot;e-mail ou senha inválidos&quot;">
      <bpmn:incoming>P2_Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P2_Enviar2FA" name="Zerar tentativas e enviar código 2FA por e-mail">
      <bpmn:incoming>P2_Fluxo_5</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P2_Codigo" name="Informar o código de 6 dígitos">
      <bpmn:incoming>P2_Fluxo_12</bpmn:incoming>
      <bpmn:incoming>P2_Fluxo_15</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_G_Codigo" name="Código válido (5 min)?">
      <bpmn:incoming>P2_Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_14</bpmn:outgoing>
      <bpmn:outgoing>P2_Fluxo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_Token" name="Gerar token JWT e registrar LOGIN no log">
      <bpmn:incoming>P2_Fluxo_14</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P2_Fim_Painel" name="Painel do perfil aberto">
      <bpmn:incoming>P2_Fluxo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P2_AvisoBloqueio" name="Avisar conta bloqueada (403)">
      <bpmn:incoming>P2_Fluxo_4</bpmn:incoming>
      <bpmn:incoming>P2_Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2_Esqueci" name="Clicar em &quot;Esqueci minha senha&quot; e informar o e-mail">
      <bpmn:incoming>P2_Fluxo_17</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P2_EnviarLink" name="Gerar link (30 min, uso único) e enviar por e-mail">
      <bpmn:incoming>P2_Fluxo_18</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P2_NovaSenha" name="Abrir o link e criar nova senha">
      <bpmn:incoming>P2_Fluxo_19</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_Desbloquear" name="Trocar a senha, zerar tentativas e desbloquear">
      <bpmn:incoming>P2_Fluxo_20</bpmn:incoming>
      <bpmn:outgoing>P2_Fluxo_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P2_Fim_Recuperada" name="Senha redefinida">
      <bpmn:incoming>P2_Fluxo_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_Fluxo_1" sourceRef="P2_Inicio" targetRef="P2_Credenciais" />
    <bpmn:sequenceFlow id="P2_Fluxo_2" sourceRef="P2_Credenciais" targetRef="P2_G_Bloqueada" />
    <bpmn:sequenceFlow id="P2_Fluxo_3" name="Não" sourceRef="P2_G_Bloqueada" targetRef="P2_G_Senha" />
    <bpmn:sequenceFlow id="P2_Fluxo_4" name="Sim" sourceRef="P2_G_Bloqueada" targetRef="P2_AvisoBloqueio" />
    <bpmn:sequenceFlow id="P2_Fluxo_5" name="Sim" sourceRef="P2_G_Senha" targetRef="P2_Enviar2FA" />
    <bpmn:sequenceFlow id="P2_Fluxo_6" name="Não" sourceRef="P2_G_Senha" targetRef="P2_SomarErro" />
    <bpmn:sequenceFlow id="P2_Fluxo_7" sourceRef="P2_SomarErro" targetRef="P2_G_Terceira" />
    <bpmn:sequenceFlow id="P2_Fluxo_8" name="Não" sourceRef="P2_G_Terceira" targetRef="P2_AvisoInvalido" />
    <bpmn:sequenceFlow id="P2_Fluxo_9" name="Sim" sourceRef="P2_G_Terceira" targetRef="P2_Bloquear" />
    <bpmn:sequenceFlow id="P2_Fluxo_10" sourceRef="P2_AvisoInvalido" targetRef="P2_Credenciais" />
    <bpmn:sequenceFlow id="P2_Fluxo_11" sourceRef="P2_Bloquear" targetRef="P2_AvisoBloqueio" />
    <bpmn:sequenceFlow id="P2_Fluxo_12" sourceRef="P2_Enviar2FA" targetRef="P2_Codigo" />
    <bpmn:sequenceFlow id="P2_Fluxo_13" sourceRef="P2_Codigo" targetRef="P2_G_Codigo" />
    <bpmn:sequenceFlow id="P2_Fluxo_14" name="Sim" sourceRef="P2_G_Codigo" targetRef="P2_Token" />
    <bpmn:sequenceFlow id="P2_Fluxo_15" name="Não" sourceRef="P2_G_Codigo" targetRef="P2_Codigo" />
    <bpmn:sequenceFlow id="P2_Fluxo_16" sourceRef="P2_Token" targetRef="P2_Fim_Painel" />
    <bpmn:sequenceFlow id="P2_Fluxo_17" sourceRef="P2_AvisoBloqueio" targetRef="P2_Esqueci" />
    <bpmn:sequenceFlow id="P2_Fluxo_18" sourceRef="P2_Esqueci" targetRef="P2_EnviarLink" />
    <bpmn:sequenceFlow id="P2_Fluxo_19" sourceRef="P2_EnviarLink" targetRef="P2_NovaSenha" />
    <bpmn:sequenceFlow id="P2_Fluxo_20" sourceRef="P2_NovaSenha" targetRef="P2_Desbloquear" />
    <bpmn:sequenceFlow id="P2_Fluxo_21" sourceRef="P2_Desbloquear" targetRef="P2_Fim_Recuperada" />
  </bpmn:process>
  <bpmn:process id="P3_Processo_02-entrada-e-saida-de-turma" isExecutable="false">
    <bpmn:laneSet id="P3_Raias_02-entrada-e-saida-de-turma">
      <bpmn:lane id="P3_R_Aluno" name="Aluno">
        <bpmn:flowNodeRef>P3_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Escolher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_G_Matriculado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_PedirEntrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_PedirSair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Fim_Nao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Fim_Atualizada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Fim_Recusado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_R_Sistema" name="Sistema MenteUp">
        <bpmn:flowNodeRef>P3_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_G_Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Recusar409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Atualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_MarcarRecusado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_AtualizarDireto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_R_Professor" name="Professor da turma ou Administrador">
        <bpmn:flowNodeRef>P3_Analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_G_Aprovar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Inicio_Direto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Direto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Fim_Direto</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_Inicio" name="Acessar Turmas">
      <bpmn:outgoing>P3_Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P3_Escolher" name="Escolher a turma">
      <bpmn:incoming>P3_Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>P3_Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_G_Matriculado" name="Já está na turma?">
      <bpmn:incoming>P3_Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>P3_Fluxo_3</bpmn:outgoing>
