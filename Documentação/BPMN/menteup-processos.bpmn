  <bpmn:process id="Processo_05-monitoramento-dashboard-grafana" isExecutable="false">
    <bpmn:laneSet id="Raias_05-monitoramento-dashboard-grafana">
      <bpmn:lane id="R_Usuario_05" name="Usuário (aluno, professor ou administrador)"><bpmn:flowNodeRef>Inicio_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Filtros_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Mostrar_05</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Admin_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Painel_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Abrir_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Analisar_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_05</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Api_05" name="Back-end MenteUp (API /dashboard)"><bpmn:flowNodeRef>Recortar_05</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Token_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Negar_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Calcular_05</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Grafana_05" name="Grafana Cloud (plugin Infinity)"><bpmn:flowNodeRef>Chamar_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Erro_05</bpmn:flowNodeRef><bpmn:flowNodeRef>Montar_05</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_05" name="Abrir o Painel"><bpmn:outgoing>Fluxo_1_05</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Filtros_05" name="Escolher período, turma e aluno"><bpmn:incoming>Fluxo_1_05</bpmn:incoming><bpmn:outgoing>Fluxo_2_05</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Recortar_05" name="Recortar os dados pelo perfil (aluno: os seus; professor: suas turmas; admin: tudo)"><bpmn:incoming>Fluxo_2_05</bpmn:incoming><bpmn:outgoing>Fluxo_3_05</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Mostrar_05" name="Ver os indicadores e gráficos"><bpmn:incoming>Fluxo_3_05</bpmn:incoming><bpmn:outgoing>Fluxo_4_05</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Admin_05" name="É administrador e quer o Grafana?"><bpmn:incoming>Fluxo_4_05</bpmn:incoming><bpmn:outgoing>Fluxo_5_05</bpmn:outgoing><bpmn:outgoing>Fluxo_6_05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fim_Painel_05" name="Acompanhamento concluído"><bpmn:incoming>Fluxo_6_05</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Abrir_05" name="Abrir o Grafana pelo botão do painel"><bpmn:incoming>Fluxo_5_05</bpmn:incoming><bpmn:outgoing>Fluxo_7_05</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="Chamar_05" name="Chamar a API com o cabeçalho X-Dashboard-Token"><bpmn:incoming>Fluxo_7_05</bpmn:incoming><bpmn:outgoing>Fluxo_8_05</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_Token_05" name="Token válido?"><bpmn:incoming>Fluxo_8_05</bpmn:incoming><bpmn:outgoing>Fluxo_9_05</bpmn:outgoing><bpmn:outgoing>Fluxo_10_05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Negar_05" name="Responder 401"><bpmn:incoming>Fluxo_10_05</bpmn:incoming><bpmn:outgoing>Fluxo_11_05</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Erro_05" name="Painel com erro"><bpmn:incoming>Fluxo_11_05</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Calcular_05" name="Calcular os indicadores agregados (sem dados pessoais)"><bpmn:incoming>Fluxo_9_05</bpmn:incoming><bpmn:outgoing>Fluxo_12_05</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Montar_05" name="Montar Big Numbers e gráficos"><bpmn:incoming>Fluxo_12_05</bpmn:incoming><bpmn:outgoing>Fluxo_13_05</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Analisar_05" name="Analisar o uso e o aprendizado da plataforma"><bpmn:incoming>Fluxo_13_05</bpmn:incoming><bpmn:outgoing>Fluxo_14_05</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="Fim_05" name="Monitoramento concluído"><bpmn:incoming>Fluxo_14_05</bpmn:incoming></bpmn:endEvent>
