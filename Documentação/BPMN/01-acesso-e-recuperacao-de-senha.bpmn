    <bpmn:textAnnotation id="Nota_1_01"><bpmn:text>Depois de 5 erros o código é bloqueado; o reenvio respeita 60 s e no máximo 3 em 15 min.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Nota_1_01" sourceRef="Codigo_01" targetRef="Nota_1_01" />
    <bpmn:textAnnotation id="Nota_2_01"><bpmn:text>Se saiu uma versão nova do Termo ou da Política, a API responde 428 até a pessoa aceitar.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Nota_2_01" sourceRef="NovoAceite_01" targetRef="Nota_2_01" />
  </bpmn:process>
