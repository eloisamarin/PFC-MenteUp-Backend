<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_01-acesso-e-recuperacao-de-senha" targetNamespace="https://menteup.umc.br/bpmn" exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_01-acesso-e-recuperacao-de-senha">
    <bpmn:participant id="Participante_01-acesso-e-recuperacao-de-senha" name="MenteUp — Acesso (2FA), primeiro acesso e recuperação de senha" processRef="Processo_01-acesso-e-recuperacao-de-senha" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_01-acesso-e-recuperacao-de-senha" isExecutable="false">
    <bpmn:laneSet id="Raias_01-acesso-e-recuperacao-de-senha">
      <bpmn:lane id="R_Usuario_01" name="Usuário (aluno, professor ou administrador)"><bpmn:flowNodeRef>Inicio_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Credenciais_01</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoBloqueio_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Bloq_01</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoStatus_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Status_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Codigo_01</bpmn:flowNodeRef><bpmn:flowNodeRef>NovoAceite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Painel_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Inicio_Rec_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Esqueci_01</bpmn:flowNodeRef><bpmn:flowNodeRef>NovaSenha_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Recuperada_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Inicio_Convite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>PrimeiroAcesso_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Convite_01</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Sistema_01" name="Sistema MenteUp"><bpmn:flowNodeRef>G_Bloqueada_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Senha_01</bpmn:flowNodeRef><bpmn:flowNodeRef>SomarErro_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Terceira_01</bpmn:flowNodeRef><bpmn:flowNodeRef>AvisoInvalido_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Bloquear_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Bloqueada_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Status_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Enviar2FA_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Codigo_01</bpmn:flowNodeRef><bpmn:flowNodeRef>ErroCodigo_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Token_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Aceite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Limite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Limite_01</bpmn:flowNodeRef><bpmn:flowNodeRef>EnviarLink_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Desbloquear_01</bpmn:flowNodeRef><bpmn:flowNodeRef>Ativar_01</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_01" name="Acessar o MenteUp"><bpmn:outgoing>Fluxo_1_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Credenciais_01" name="Informar e-mail e senha"><bpmn:incoming>Fluxo_1_01</bpmn:incoming><bpmn:incoming>Fluxo_11_01</bpmn:incoming><bpmn:outgoing>Fluxo_2_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Bloqueada_01" name="Conta bloqueada?"><bpmn:incoming>Fluxo_2_01</bpmn:incoming><bpmn:outgoing>Fluxo_3_01</bpmn:outgoing><bpmn:outgoing>Fluxo_4_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoBloqueio_01" name="Avisar conta bloqueada e indicar &quot;Esqueci minha senha&quot;"><bpmn:incoming>Fluxo_4_01</bpmn:incoming><bpmn:outgoing>Fluxo_5_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Bloq_01" name="Seguir para a recuperação"><bpmn:incoming>Fluxo_5_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Senha_01" name="Senha correta?"><bpmn:incoming>Fluxo_3_01</bpmn:incoming><bpmn:outgoing>Fluxo_6_01</bpmn:outgoing><bpmn:outgoing>Fluxo_7_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SomarErro_01" name="Somar tentativa errada"><bpmn:incoming>Fluxo_7_01</bpmn:incoming><bpmn:outgoing>Fluxo_8_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Terceira_01" name="3ª tentativa seguida?"><bpmn:incoming>Fluxo_8_01</bpmn:incoming><bpmn:outgoing>Fluxo_9_01</bpmn:outgoing><bpmn:outgoing>Fluxo_10_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoInvalido_01" name="Avisar &quot;e-mail ou senha inválidos&quot;"><bpmn:incoming>Fluxo_9_01</bpmn:incoming><bpmn:outgoing>Fluxo_11_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Bloquear_01" name="Bloquear a conta e encerrar as sessões abertas"><bpmn:incoming>Fluxo_10_01</bpmn:incoming><bpmn:outgoing>Fluxo_12_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Bloqueada_01" name="Conta bloqueada"><bpmn:incoming>Fluxo_12_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Status_01" name="Professor pendente ou rejeitado?"><bpmn:incoming>Fluxo_6_01</bpmn:incoming><bpmn:outgoing>Fluxo_13_01</bpmn:outgoing><bpmn:outgoing>Fluxo_14_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AvisoStatus_01" name="Avisar &quot;aguardando aprovação&quot; ou &quot;cadastro rejeitado&quot;"><bpmn:incoming>Fluxo_14_01</bpmn:incoming><bpmn:outgoing>Fluxo_15_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Status_01" name="Acesso não liberado"><bpmn:incoming>Fluxo_15_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="Enviar2FA_01" name="Enviar o código 2FA por e-mail (5 min, guardado em hash)"><bpmn:incoming>Fluxo_13_01</bpmn:incoming><bpmn:outgoing>Fluxo_16_01</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="Codigo_01" name="Informar o código (pode pedir reenvio: até 3, a cada 60 s)"><bpmn:incoming>Fluxo_16_01</bpmn:incoming><bpmn:incoming>Fluxo_20_01</bpmn:incoming><bpmn:outgoing>Fluxo_17_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Codigo_01" name="Código válido?"><bpmn:incoming>Fluxo_17_01</bpmn:incoming><bpmn:outgoing>Fluxo_18_01</bpmn:outgoing><bpmn:outgoing>Fluxo_19_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ErroCodigo_01" name="Contar o erro (após 5, é preciso pedir novo código)"><bpmn:incoming>Fluxo_19_01</bpmn:incoming><bpmn:outgoing>Fluxo_20_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Token_01" name="Gerar o token JWT e registrar LOGIN no log"><bpmn:incoming>Fluxo_18_01</bpmn:incoming><bpmn:outgoing>Fluxo_21_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Aceite_01" name="Aceitou a versão atual do Termo e da Política?"><bpmn:incoming>Fluxo_21_01</bpmn:incoming><bpmn:outgoing>Fluxo_22_01</bpmn:outgoing><bpmn:outgoing>Fluxo_23_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="NovoAceite_01" name="Ler e aceitar a nova versão"><bpmn:incoming>Fluxo_23_01</bpmn:incoming><bpmn:outgoing>Fluxo_24_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="Fim_Painel_01" name="Painel do perfil aberto"><bpmn:incoming>Fluxo_22_01</bpmn:incoming><bpmn:incoming>Fluxo_24_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Inicio_Rec_01" name="Esqueceu a senha ou teve a conta bloqueada"><bpmn:outgoing>Fluxo_25_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Esqueci_01" name="Pedir &quot;Esqueci minha senha&quot; informando o e-mail"><bpmn:incoming>Fluxo_25_01</bpmn:incoming><bpmn:outgoing>Fluxo_26_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Limite_01" name="Dentro do limite de pedidos (IP e e-mail)?"><bpmn:incoming>Fluxo_26_01</bpmn:incoming><bpmn:outgoing>Fluxo_27_01</bpmn:outgoing><bpmn:outgoing>Fluxo_28_01</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fim_Limite_01" name="Pedido ignorado"><bpmn:incoming>Fluxo_28_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="EnviarLink_01" name="Enviar o link (30 min, uso único); a resposta é igual exista ou não o e-mail"><bpmn:incoming>Fluxo_27_01</bpmn:incoming><bpmn:outgoing>Fluxo_29_01</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="NovaSenha_01" name="Abrir o link e criar uma senha forte"><bpmn:incoming>Fluxo_29_01</bpmn:incoming><bpmn:outgoing>Fluxo_30_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Desbloquear_01" name="Trocar a senha, desbloquear e encerrar as sessões abertas"><bpmn:incoming>Fluxo_30_01</bpmn:incoming><bpmn:outgoing>Fluxo_31_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Recuperada_01" name="Senha redefinida: voltar ao login"><bpmn:incoming>Fluxo_31_01</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Inicio_Convite_01" name="Receber o convite criado pelo administrador (72 h)"><bpmn:outgoing>Fluxo_32_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="PrimeiroAcesso_01" name="Definir a senha e aceitar o Termo e a Política"><bpmn:incoming>Fluxo_32_01</bpmn:incoming><bpmn:outgoing>Fluxo_33_01</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Ativar_01" name="Salvar a senha e registrar o aceite"><bpmn:incoming>Fluxo_33_01</bpmn:incoming><bpmn:outgoing>Fluxo_34_01</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Convite_01" name="Conta ativada: seguir para o login"><bpmn:incoming>Fluxo_34_01</bpmn:incoming></bpmn:endEvent>
