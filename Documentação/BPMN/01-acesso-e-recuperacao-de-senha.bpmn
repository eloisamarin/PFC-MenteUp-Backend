<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definicoes_01-acesso-e-recuperacao-de-senha" targetNamespace="https://menteup.umc.br/bpmn"
                  exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_01-acesso-e-recuperacao-de-senha">
    <bpmn:participant id="Participante_01-acesso-e-recuperacao-de-senha" name="MenteUp — Acesso, bloqueio e recuperação de senha" processRef="Processo_01-acesso-e-recuperacao-de-senha" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_01-acesso-e-recuperacao-de-senha" isExecutable="false">
    <bpmn:laneSet id="Raias_01-acesso-e-recuperacao-de-senha">
      <bpmn:lane id="R_Usuario" name="Usuário (aluno, professor ou administrador)">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Credenciais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AvisoInvalido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Codigo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Painel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Esqueci</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NovaSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Recuperada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="R_Sistema" name="Sistema MenteUp">
        <bpmn:flowNodeRef>G_Bloqueada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Senha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SomarErro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Terceira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bloquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enviar2FA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Codigo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AvisoBloqueio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnviarLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Desbloquear</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Acessar o MenteUp">
      <bpmn:outgoing>Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Credenciais" name="Informar e-mail e senha">
      <bpmn:incoming>Fluxo_1</bpmn:incoming>
      <bpmn:incoming>Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Bloqueada" name="Conta bloqueada?">
      <bpmn:incoming>Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>Fluxo_3</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Senha" name="Senha correta?">
      <bpmn:incoming>Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_5</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SomarErro" name="Somar tentativa errada">
      <bpmn:incoming>Fluxo_6</bpmn:incoming>
      <bpmn:outgoing>Fluxo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Terceira" name="3ª tentativa seguida?">
      <bpmn:incoming>Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>Fluxo_8</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Bloquear" name="Bloquear a conta">
      <bpmn:incoming>Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AvisoInvalido" name="Avisar &quot;e-mail ou senha inválidos&quot;">
      <bpmn:incoming>Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>Fluxo_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Enviar2FA" name="Zerar tentativas e enviar código 2FA por e-mail">
      <bpmn:incoming>Fluxo_5</bpmn:incoming>
      <bpmn:outgoing>Fluxo_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Codigo" name="Informar o código de 6 dígitos">
      <bpmn:incoming>Fluxo_12</bpmn:incoming>
      <bpmn:incoming>Fluxo_15</bpmn:incoming>
      <bpmn:outgoing>Fluxo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Codigo" name="Código válido (5 min)?">
      <bpmn:incoming>Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>Fluxo_14</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Token" name="Gerar token JWT e registrar LOGIN no log">
      <bpmn:incoming>Fluxo_14</bpmn:incoming>
      <bpmn:outgoing>Fluxo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Painel" name="Painel do perfil aberto">
      <bpmn:incoming>Fluxo_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="AvisoBloqueio" name="Avisar conta bloqueada (403)">
      <bpmn:incoming>Fluxo_4</bpmn:incoming>
      <bpmn:incoming>Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Esqueci" name="Clicar em &quot;Esqueci minha senha&quot; e informar o e-mail">
      <bpmn:incoming>Fluxo_17</bpmn:incoming>
      <bpmn:outgoing>Fluxo_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="EnviarLink" name="Gerar link (30 min, uso único) e enviar por e-mail">
      <bpmn:incoming>Fluxo_18</bpmn:incoming>
      <bpmn:outgoing>Fluxo_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="NovaSenha" name="Abrir o link e criar nova senha">
      <bpmn:incoming>Fluxo_19</bpmn:incoming>
      <bpmn:outgoing>Fluxo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Desbloquear" name="Trocar a senha, zerar tentativas e desbloquear">
      <bpmn:incoming>Fluxo_20</bpmn:incoming>
      <bpmn:outgoing>Fluxo_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Recuperada" name="Senha redefinida">
      <bpmn:incoming>Fluxo_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_1" sourceRef="Inicio" targetRef="Credenciais" />
    <bpmn:sequenceFlow id="Fluxo_2" sourceRef="Credenciais" targetRef="G_Bloqueada" />
    <bpmn:sequenceFlow id="Fluxo_3" name="Não" sourceRef="G_Bloqueada" targetRef="G_Senha" />
    <bpmn:sequenceFlow id="Fluxo_4" name="Sim" sourceRef="G_Bloqueada" targetRef="AvisoBloqueio" />
    <bpmn:sequenceFlow id="Fluxo_5" name="Sim" sourceRef="G_Senha" targetRef="Enviar2FA" />
    <bpmn:sequenceFlow id="Fluxo_6" name="Não" sourceRef="G_Senha" targetRef="SomarErro" />
    <bpmn:sequenceFlow id="Fluxo_7" sourceRef="SomarErro" targetRef="G_Terceira" />
    <bpmn:sequenceFlow id="Fluxo_8" name="Não" sourceRef="G_Terceira" targetRef="AvisoInvalido" />
    <bpmn:sequenceFlow id="Fluxo_9" name="Sim" sourceRef="G_Terceira" targetRef="Bloquear" />
    <bpmn:sequenceFlow id="Fluxo_10" sourceRef="AvisoInvalido" targetRef="Credenciais" />
    <bpmn:sequenceFlow id="Fluxo_11" sourceRef="Bloquear" targetRef="AvisoBloqueio" />
    <bpmn:sequenceFlow id="Fluxo_12" sourceRef="Enviar2FA" targetRef="Codigo" />
    <bpmn:sequenceFlow id="Fluxo_13" sourceRef="Codigo" targetRef="G_Codigo" />
    <bpmn:sequenceFlow id="Fluxo_14" name="Sim" sourceRef="G_Codigo" targetRef="Token" />
    <bpmn:sequenceFlow id="Fluxo_15" name="Não" sourceRef="G_Codigo" targetRef="Codigo" />
    <bpmn:sequenceFlow id="Fluxo_16" sourceRef="Token" targetRef="Fim_Painel" />
    <bpmn:sequenceFlow id="Fluxo_17" sourceRef="AvisoBloqueio" targetRef="Esqueci" />
    <bpmn:sequenceFlow id="Fluxo_18" sourceRef="Esqueci" targetRef="EnviarLink" />
    <bpmn:sequenceFlow id="Fluxo_19" sourceRef="EnviarLink" targetRef="NovaSenha" />
    <bpmn:sequenceFlow id="Fluxo_20" sourceRef="NovaSenha" targetRef="Desbloquear" />
    <bpmn:sequenceFlow id="Fluxo_21" sourceRef="Desbloquear" targetRef="Fim_Recuperada" />
  </bpmn:process>
