<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_04-desafio-ao-vivo" targetNamespace="https://menteup.umc.br/bpmn" exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_04-desafio-ao-vivo">
    <bpmn:participant id="Participante_04-desafio-ao-vivo" name="MenteUp — Desafio ao vivo" processRef="Processo_04-desafio-ao-vivo" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_04-desafio-ao-vivo" isExecutable="false">
    <bpmn:laneSet id="Raias_04-desafio-ao-vivo">
      <bpmn:lane id="R_Professor_04" name="Professor (ou Administrador)"><bpmn:flowNodeRef>Inicio_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Criar_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Iniciar_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Avancar_04</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Sistema_04" name="Sistema MenteUp"><bpmn:flowNodeRef>G_Posse_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Negar_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Negado_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Abrir_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Pontuar_04</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Mais_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Encerrar_04</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Aluno_04" name="Aluno da turma"><bpmn:flowNodeRef>Escolher_04</bpmn:flowNodeRef><bpmn:flowNodeRef>VerRanking_04</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_04</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_04" name="Preparar desafio"><bpmn:outgoing>Fluxo_1_04</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Criar_04" name="Criar o desafio: perguntas, 2 a 4 alternativas e tempo (5 a 300 s)"><bpmn:incoming>Fluxo_1_04</bpmn:incoming><bpmn:outgoing>Fluxo_2_04</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Posse_04" name="Turma ativa e do professor (ou é admin)?"><bpmn:incoming>Fluxo_2_04</bpmn:incoming><bpmn:outgoing>Fluxo_3_04</bpmn:outgoing><bpmn:outgoing>Fluxo_4_04</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Negar_04" name="Recusar e explicar o motivo"><bpmn:incoming>Fluxo_4_04</bpmn:incoming><bpmn:outgoing>Fluxo_5_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Negado_04" name="Desafio não criado"><bpmn:incoming>Fluxo_5_04</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Iniciar_04" name="Iniciar o desafio com a turma"><bpmn:incoming>Fluxo_3_04</bpmn:incoming><bpmn:outgoing>Fluxo_6_04</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Abrir_04" name="Mostrar a pergunta e iniciar o cronômetro"><bpmn:incoming>Fluxo_6_04</bpmn:incoming><bpmn:incoming>Fluxo_11_04</bpmn:incoming><bpmn:outgoing>Fluxo_7_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Escolher_04" name="Escolher a alternativa antes do tempo acabar"><bpmn:incoming>Fluxo_7_04</bpmn:incoming><bpmn:outgoing>Fluxo_8_04</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Pontuar_04" name="Registrar a resposta e os pontos (certo e rápido vale mais)"><bpmn:incoming>Fluxo_8_04</bpmn:incoming><bpmn:outgoing>Fluxo_9_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Avancar_04" name="Avançar para a próxima pergunta"><bpmn:incoming>Fluxo_9_04</bpmn:incoming><bpmn:outgoing>Fluxo_10_04</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Mais_04" name="Há mais perguntas?"><bpmn:incoming>Fluxo_10_04</bpmn:incoming><bpmn:outgoing>Fluxo_11_04</bpmn:outgoing><bpmn:outgoing>Fluxo_12_04</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Encerrar_04" name="Encerrar e calcular o ranking do desafio"><bpmn:incoming>Fluxo_12_04</bpmn:incoming><bpmn:outgoing>Fluxo_13_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="VerRanking_04" name="Ver o ranking final"><bpmn:incoming>Fluxo_13_04</bpmn:incoming><bpmn:outgoing>Fluxo_14_04</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="Fim_04" name="Desafio encerrado"><bpmn:incoming>Fluxo_14_04</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_1_04" sourceRef="Inicio_04" targetRef="Criar_04" />
    <bpmn:sequenceFlow id="Fluxo_2_04" sourceRef="Criar_04" targetRef="G_Posse_04" />
    <bpmn:sequenceFlow id="Fluxo_3_04" name="Sim" sourceRef="G_Posse_04" targetRef="Iniciar_04" />
    <bpmn:sequenceFlow id="Fluxo_4_04" name="Não" sourceRef="G_Posse_04" targetRef="Negar_04" />
    <bpmn:sequenceFlow id="Fluxo_5_04" sourceRef="Negar_04" targetRef="Fim_Negado_04" />
    <bpmn:sequenceFlow id="Fluxo_6_04" sourceRef="Iniciar_04" targetRef="Abrir_04" />
    <bpmn:sequenceFlow id="Fluxo_7_04" sourceRef="Abrir_04" targetRef="Escolher_04" />
    <bpmn:sequenceFlow id="Fluxo_8_04" sourceRef="Escolher_04" targetRef="Pontuar_04" />
    <bpmn:sequenceFlow id="Fluxo_9_04" sourceRef="Pontuar_04" targetRef="Avancar_04" />
    <bpmn:sequenceFlow id="Fluxo_10_04" sourceRef="Avancar_04" targetRef="G_Mais_04" />
    <bpmn:sequenceFlow id="Fluxo_11_04" name="Sim" sourceRef="G_Mais_04" targetRef="Abrir_04" />
    <bpmn:sequenceFlow id="Fluxo_12_04" name="Não" sourceRef="G_Mais_04" targetRef="Encerrar_04" />
    <bpmn:sequenceFlow id="Fluxo_13_04" sourceRef="Encerrar_04" targetRef="VerRanking_04" />
    <bpmn:sequenceFlow id="Fluxo_14_04" sourceRef="VerRanking_04" targetRef="Fim_04" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_04-desafio-ao-vivo">
