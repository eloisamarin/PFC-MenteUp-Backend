      <bpmndi:BPMNShape id="Nota_1_di" bpmnElement="Nota_1">
        <dc:Bounds x="355" y="730" width="210" height="60" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
