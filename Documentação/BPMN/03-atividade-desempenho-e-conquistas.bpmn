  <bpmn:collaboration id="Colaboracao_03-atividade-desempenho-e-conquistas">
    <bpmn:participant id="Participante_03-atividade-desempenho-e-conquistas" name="MenteUp — Atividade, desempenho e conquistas" processRef="Processo_03-atividade-desempenho-e-conquistas" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_03-atividade-desempenho-e-conquistas" isExecutable="false">
    <bpmn:laneSet id="Raias_03-atividade-desempenho-e-conquistas">
      <bpmn:lane id="R_Professor_03" name="Professor (ou Administrador)"><bpmn:flowNodeRef>Inicio_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Criar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_Negado_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Questoes_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Publicar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Analisar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Comentar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Comentar_03</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Sistema_03" name="Sistema MenteUp"><bpmn:flowNodeRef>G_Posse_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Negar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Notificar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Salvar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Todas_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Corrigir_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Conquistas_03</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Conquista_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Ranking_03</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="R_Aluno_03" name="Aluno"><bpmn:flowNodeRef>Responder_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Comemorar_03</bpmn:flowNodeRef><bpmn:flowNodeRef>VerComentario_03</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim_03</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_03" name="Planejar atividade"><bpmn:outgoing>Fluxo_1_03</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Criar_03" name="Criar a atividade, escolher o template e a(s) turma(s)"><bpmn:incoming>Fluxo_1_03</bpmn:incoming><bpmn:outgoing>Fluxo_2_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Posse_03" name="As turmas são do professor (ou é admin)?"><bpmn:incoming>Fluxo_2_03</bpmn:incoming><bpmn:outgoing>Fluxo_3_03</bpmn:outgoing><bpmn:outgoing>Fluxo_4_03</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Negar_03" name="Recusar (403) e registrar ACESSO_NEGADO"><bpmn:incoming>Fluxo_4_03</bpmn:incoming><bpmn:outgoing>Fluxo_5_03</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Fim_Negado_03" name="Atividade não criada"><bpmn:incoming>Fluxo_5_03</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Questoes_03" name="Cadastrar as questões e o gabarito"><bpmn:incoming>Fluxo_3_03</bpmn:incoming><bpmn:outgoing>Fluxo_6_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Publicar_03" name="Publicar para as turmas"><bpmn:incoming>Fluxo_6_03</bpmn:incoming><bpmn:outgoing>Fluxo_7_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="Notificar_03" name="Notificar os alunos (Firebase, quando ligado)"><bpmn:incoming>Fluxo_7_03</bpmn:incoming><bpmn:outgoing>Fluxo_8_03</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="Responder_03" name="Responder as questões"><bpmn:incoming>Fluxo_8_03</bpmn:incoming><bpmn:incoming>Fluxo_11_03</bpmn:incoming><bpmn:outgoing>Fluxo_9_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Salvar_03" name="Salvar o progresso de cada resposta"><bpmn:incoming>Fluxo_9_03</bpmn:incoming><bpmn:outgoing>Fluxo_10_03</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Todas_03" name="Respondeu todas?"><bpmn:incoming>Fluxo_10_03</bpmn:incoming><bpmn:outgoing>Fluxo_11_03</bpmn:outgoing><bpmn:outgoing>Fluxo_12_03</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Corrigir_03" name="Corrigir, calcular acertos e pontuação"><bpmn:incoming>Fluxo_12_03</bpmn:incoming><bpmn:outgoing>Fluxo_13_03</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Conquistas_03" name="Avaliar conquistas, XP e Intensivão"><bpmn:incoming>Fluxo_13_03</bpmn:incoming><bpmn:outgoing>Fluxo_14_03</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Conquista_03" name="Nova conquista?"><bpmn:incoming>Fluxo_14_03</bpmn:incoming><bpmn:outgoing>Fluxo_15_03</bpmn:outgoing><bpmn:outgoing>Fluxo_16_03</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Comemorar_03" name="Ver a comemoração da conquista"><bpmn:incoming>Fluxo_15_03</bpmn:incoming><bpmn:outgoing>Fluxo_17_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Ranking_03" name="Atualizar ranking, desempenho e painel"><bpmn:incoming>Fluxo_16_03</bpmn:incoming><bpmn:incoming>Fluxo_17_03</bpmn:incoming><bpmn:outgoing>Fluxo_18_03</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Analisar_03" name="Analisar o desempenho da turma e de cada aluno"><bpmn:incoming>Fluxo_18_03</bpmn:incoming><bpmn:outgoing>Fluxo_19_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Comentar_03" name="Deseja comentar?"><bpmn:incoming>Fluxo_19_03</bpmn:incoming><bpmn:outgoing>Fluxo_20_03</bpmn:outgoing><bpmn:outgoing>Fluxo_21_03</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Comentar_03" name="Escrever comentário no resultado do aluno"><bpmn:incoming>Fluxo_20_03</bpmn:incoming><bpmn:outgoing>Fluxo_22_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="VerComentario_03" name="Ver o resultado e o comentário"><bpmn:incoming>Fluxo_21_03</bpmn:incoming><bpmn:incoming>Fluxo_22_03</bpmn:incoming><bpmn:outgoing>Fluxo_23_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="Fim_03" name="Ciclo da atividade concluído"><bpmn:incoming>Fluxo_23_03</bpmn:incoming></bpmn:endEvent>
