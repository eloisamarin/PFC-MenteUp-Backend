<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definicoes_03-atividade-desempenho-e-conquistas" targetNamespace="https://menteup.umc.br/bpmn"
                  exporter="MenteUp" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_03-atividade-desempenho-e-conquistas">
    <bpmn:participant id="Participante_03-atividade-desempenho-e-conquistas" name="MenteUp — Atividade, desempenho e conquistas" processRef="Processo_03-atividade-desempenho-e-conquistas" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_03-atividade-desempenho-e-conquistas" isExecutable="false">
    <bpmn:laneSet id="Raias_03-atividade-desempenho-e-conquistas">
      <bpmn:lane id="R_Professor" name="Professor">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Criar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Questoes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Comentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comentar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="R_Sistema" name="Sistema MenteUp">
        <bpmn:flowNodeRef>Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Salvar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Corrigir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Conquistas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Conquista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ranking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="R_Aluno" name="Aluno">
        <bpmn:flowNodeRef>Responder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Todas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comemorar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VerComentario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Planejar atividade">
      <bpmn:outgoing>Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Criar" name="Criar atividade e escolher o template">
      <bpmn:incoming>Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Questoes" name="Cadastrar as questões e o gabarito">
      <bpmn:incoming>Fluxo_2</bpmn:incoming>
      <bpmn:outgoing>Fluxo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Publicar" name="Publicar para a turma">
      <bpmn:incoming>Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Notificar" name="Notificar os alunos da turma (Firebase)">
      <bpmn:incoming>Fluxo_4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Responder" name="Responder as questões">
      <bpmn:incoming>Fluxo_5</bpmn:incoming>
      <bpmn:incoming>Fluxo_8</bpmn:incoming>
      <bpmn:outgoing>Fluxo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Salvar" name="Salvar o progresso de cada resposta">
      <bpmn:incoming>Fluxo_6</bpmn:incoming>
      <bpmn:outgoing>Fluxo_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Todas" name="Respondeu todas?">
      <bpmn:incoming>Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>Fluxo_8</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Enviar" name="Enviar a atividade">
      <bpmn:incoming>Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Corrigir" name="Corrigir, calcular acertos e pontuação">
      <bpmn:incoming>Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>Fluxo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Conquistas" name="Avaliar conquistas e XP">
      <bpmn:incoming>Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Conquista" name="Nova conquista?">
      <bpmn:incoming>Fluxo_12</bpmn:incoming>
      <bpmn:outgoing>Fluxo_13</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Comemorar" name="Ver a comemoração da conquista">
      <bpmn:incoming>Fluxo_13</bpmn:incoming>
      <bpmn:outgoing>Fluxo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Ranking" name="Atualizar ranking e desempenho">
      <bpmn:incoming>Fluxo_14</bpmn:incoming>
      <bpmn:incoming>Fluxo_15</bpmn:incoming>
      <bpmn:outgoing>Fluxo_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Analisar" name="Analisar desempenho da turma e de cada aluno">
      <bpmn:incoming>Fluxo_16</bpmn:incoming>
      <bpmn:outgoing>Fluxo_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Comentar" name="Deseja comentar?">
      <bpmn:incoming>Fluxo_17</bpmn:incoming>
      <bpmn:outgoing>Fluxo_18</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Comentar" name="Escrever comentário no resultado do aluno">
      <bpmn:incoming>Fluxo_18</bpmn:incoming>
      <bpmn:outgoing>Fluxo_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="VerComentario" name="Ver resultado e comentário do professor">
      <bpmn:incoming>Fluxo_19</bpmn:incoming>
      <bpmn:incoming>Fluxo_20</bpmn:incoming>
      <bpmn:outgoing>Fluxo_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Fim" name="Ciclo da atividade concluído">
      <bpmn:incoming>Fluxo_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_1" sourceRef="Inicio" targetRef="Criar" />
    <bpmn:sequenceFlow id="Fluxo_2" sourceRef="Criar" targetRef="Questoes" />
    <bpmn:sequenceFlow id="Fluxo_3" sourceRef="Questoes" targetRef="Publicar" />
    <bpmn:sequenceFlow id="Fluxo_4" sourceRef="Publicar" targetRef="Notificar" />
    <bpmn:sequenceFlow id="Fluxo_5" sourceRef="Notificar" targetRef="Responder" />
    <bpmn:sequenceFlow id="Fluxo_6" sourceRef="Responder" targetRef="Salvar" />
    <bpmn:sequenceFlow id="Fluxo_7" sourceRef="Salvar" targetRef="G_Todas" />
    <bpmn:sequenceFlow id="Fluxo_8" name="Não" sourceRef="G_Todas" targetRef="Responder" />
    <bpmn:sequenceFlow id="Fluxo_9" name="Sim" sourceRef="G_Todas" targetRef="Enviar" />
    <bpmn:sequenceFlow id="Fluxo_10" sourceRef="Enviar" targetRef="Corrigir" />
    <bpmn:sequenceFlow id="Fluxo_11" sourceRef="Corrigir" targetRef="Conquistas" />
    <bpmn:sequenceFlow id="Fluxo_12" sourceRef="Conquistas" targetRef="G_Conquista" />
    <bpmn:sequenceFlow id="Fluxo_13" name="Sim" sourceRef="G_Conquista" targetRef="Comemorar" />
    <bpmn:sequenceFlow id="Fluxo_14" name="Não" sourceRef="G_Conquista" targetRef="Ranking" />
    <bpmn:sequenceFlow id="Fluxo_15" sourceRef="Comemorar" targetRef="Ranking" />
    <bpmn:sequenceFlow id="Fluxo_16" sourceRef="Ranking" targetRef="Analisar" />
    <bpmn:sequenceFlow id="Fluxo_17" sourceRef="Analisar" targetRef="G_Comentar" />
    <bpmn:sequenceFlow id="Fluxo_18" name="Sim" sourceRef="G_Comentar" targetRef="Comentar" />
    <bpmn:sequenceFlow id="Fluxo_19" name="Não" sourceRef="G_Comentar" targetRef="VerComentario" />
    <bpmn:sequenceFlow id="Fluxo_20" sourceRef="Comentar" targetRef="VerComentario" />
    <bpmn:sequenceFlow id="Fluxo_21" sourceRef="VerComentario" targetRef="Fim" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>Templates: Quiz, Verdadeiro ou falso, Associação, Ordenação e Lacunas.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
