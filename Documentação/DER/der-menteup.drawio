        <mxCell id="r32" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startSize=10;endSize=10;strokeColor=#5F6573;rounded=1;" edge="1" parent="1" source="t_tb_resposta_desafio__2" target="t_tb_alternativa_desafio__0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r33" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startSize=10;endSize=10;strokeColor=#8FA8DA;opacity=75;rounded=1;" edge="1" parent="1" source="t_tb_resposta_desafio__3" target="t_tb_usuarios__0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="titulo" value="&lt;b&gt;MenteUp — Diagrama Entidade-Relacionamento (modelo físico · PostgreSQL 18)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="-90" width="1400" height="40" as="geometry" /></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#B7791F&quot;&gt;PK&lt;/b&gt; chave primária (sublinhada) · &lt;b style=&quot;color:#2C6FB5&quot;&gt;FK&lt;/b&gt; chave estrangeira · &lt;b style=&quot;color:#6B7685&quot;&gt;UQ&lt;/b&gt; faz parte de uma restrição UNIQUE · NN = NOT NULL&lt;br&gt;Pé de galinha: &lt;b&gt;○&amp;lt;&lt;/b&gt; zero ou muitos · &lt;b&gt;||&lt;/b&gt; exatamente um · &lt;b&gt;○|&lt;/b&gt; zero ou um&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores:&lt;/b&gt; azul = usuários e acesso · verde = turmas · amarelo = atividades · vermelho = desafios ao vivo · roxo = gamificação · azul-claro = Termo e Política (LGPD) · cinza = auditoria&lt;br&gt;&lt;br&gt;&lt;b&gt;Observações&lt;/b&gt;&lt;br&gt;• tb_codigo_2fa não tem FK: guarda o e-mail do usuário (o código vale só 5 minutos).&lt;br&gt;• log_sistema.usuario_id é opcional: falhas de login podem não ter usuário.&lt;br&gt;• log_sistema.entidade_id aponta para a tabela indicada em entidade (sem FK).&lt;br&gt;• resposta_atividade_sequencia guarda a ordem respondida (ordenação e lacunas).&lt;br&gt;• As FKs de tb_turma_aluno e tb_atividade_turma formam as relações N:N.&lt;br&gt;• Linhas azul-claras: referências a tb_usuarios (13 tabelas apontam para ela)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA0B4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="900" width="1110" height="280" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
