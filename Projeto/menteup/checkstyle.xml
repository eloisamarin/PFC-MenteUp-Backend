<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Regras de estilo do MenteUp (Checkstyle).
    Subconjunto de regras reais: imports, nomes, chaves obrigatórias e tamanho de linha.
    Severidade "warning" + violationSeverity=warning no pom.xml: qualquer violação reprova o build.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>

    <!-- Linhas muito longas. Fica FORA do TreeWalker (parent module = Checker). -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Nomes de classes, métodos e parâmetros -->
        <module name="TypeName"/>
        <!--
            Igual ao padrão do Checkstyle, mas aceitando "_":
            - derived queries do Spring Data usam "_" para propriedades aninhadas (findByUsuario_Id);
            - os testes seguem a convenção metodo_cenario_resultado.
            Continua exigindo que o nome comece com letra minúscula.
        -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="ParameterName"/>

        <!-- Chaves obrigatórias em if/else/for/while/do -->
        <module name="NeedBraces"/>
    </module>
</module>
