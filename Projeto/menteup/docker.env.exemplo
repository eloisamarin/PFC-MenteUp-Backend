# ==============================================================================
# Modelo das variáveis de ambiente para rodar o backend no Docker.
#
# Como usar:
#   1. Copie este arquivo com o nome ".env" (na mesma pasta do Dockerfile).
#   2. Troque os valores de exemplo pelos reais (os mesmos do IntelliJ).
#   3. Rode:  docker run --env-file .env -p 8080:8080 menteup
#
# O ".env" está no .gitignore: as senhas NÃO vão para o GitHub. Este modelo pode ir.
# Formato: NOME=valor, sem aspas e sem espaços em volta do "=".
# ==============================================================================

# Banco de dados. Dentro do container, "localhost" é o próprio container:
# para falar com o PostgreSQL do seu computador, use host.docker.internal.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5435/NOME_DO_BANCO
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=troque-pela-senha-do-banco

# E-mail que envia os códigos de login, convites e links de senha (senha de app do Gmail)
EMAIL_PROJETO=troque-pelo-email-do-projeto
SENHA_EMAIL=troque-pela-senha-de-app

# Chave dos tokens de login (Base64, pelo menos 32 bytes). Use a mesma do IntelliJ.
JWT_SECRET=troque-pela-chave-base64

# Firebase (notificações no celular). Dentro do container o arquivo JSON do Firebase
# não existe, e sem ele o backend não sobe. Escolha UMA das opções:
#
# Opção A (mais simples): desligar as notificações no Docker
FIREBASE_ENABLED=false
#
# Opção B: usar o arquivo do Firebase. Apague a linha FIREBASE_ENABLED acima, descomente a
# linha abaixo e, no docker run, monte o arquivo no container com:
#   -v "C:\caminho\do\arquivo-firebase.json:/app/firebase.json:ro"
# GOOGLE_APPLICATION_CREDENTIALS=/app/firebase.json

# Opcionais
MOSTRAR_SQL=false
SWAGGER_ATIVO=true
