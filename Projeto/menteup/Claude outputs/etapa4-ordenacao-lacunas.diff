@@ -0,0 +1,69 @@
+package com.umc.menteup.template;
+
+import com.umc.menteup.dto.AlternativaRequest;
+import com.umc.menteup.dto.PerguntaRequest;
+import com.umc.menteup.exception.ApiException;
+import com.umc.menteup.model.Alternativa;
+import com.umc.menteup.model.Pergunta;
+import com.umc.menteup.model.TipoAtividade;
+import org.springframework.stereotype.Component;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+
+///Ordenação: a pergunta é a instrução e as alternativas são os itens, cada um com sua posição correta em "ordem"
+///O aluno envia todos os itens na ordem que acha correta e só acerta se a sequência inteira estiver certa
+@Component
+public class OrdenacaoTemplate extends SequenciaTemplate {
+
+    @Override
+    public TipoAtividade tipo() {
+        return TipoAtividade.ORDENACAO;
+    }
+
+    ///Pelo menos 2 itens e as ordens devem ir de 1 até a quantidade de itens, sem repetir
+    @Override
+    public void validarCriacao(PerguntaRequest pergunta) {
+        List<AlternativaRequest> itens = pergunta.alternativas();
+
+        if (itens.size() < 2) {
+            throw invalida("A pergunta \"" + pergunta.enunciado() + "\" precisa de pelo menos 2 itens para ordenar.");
+        }
+
+        if (itens.stream().map(AlternativaRequest::ordem).anyMatch(Objects::isNull)) {
+            throw invalida("Todos os itens de \"" + pergunta.enunciado() + "\" precisam informar a ordem.");
+        }
+
+        Set<Integer> ordens = itens.stream().map(AlternativaRequest::ordem).collect(Collectors.toSet());
+        Set<Integer> esperadas = IntStream.rangeClosed(1, itens.size()).boxed().collect(Collectors.toSet());
+
+        if (ordens.size() != itens.size() || !ordens.equals(esperadas)) {
+            throw invalida("A ordem dos itens de \"" + pergunta.enunciado()
+                    + "\" deve ir de 1 a " + itens.size() + ", sem repetir.");
+        }
+    }
+
+    ///O aluno precisa posicionar todos os itens
+    @Override
+    protected int tamanhoEsperado(Pergunta pergunta) {
+        return pergunta.getAlternativas().size();
+    }
+
+    ///Correta quando o item da posição i tem ordem i + 1
+    @Override
+    protected boolean sequenciaCorreta(Pergunta pergunta, List<Alternativa> sequencia) {
+        for (int i = 0; i < sequencia.size(); i++) {
+            if (!Objects.equals(sequencia.get(i).getOrdem(), i + 1)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static ApiException invalida(String mensagem) {
+        return ApiException.requisicaoInvalida("ORDENACAO_INVALIDA", mensagem);
+    }
+}
diff -ruN --strip-trailing-cr orig4/src/main/java/com/umc/menteup/template/SequenciaTemplate.java menteup/src/main/java/com/umc/menteup/template/SequenciaTemplate.java
--- orig4/src/main/java/com/umc/menteup/template/SequenciaTemplate.java	1969-12-31 21:00:00.000000000 -0300
+++ menteup/src/main/java/com/umc/menteup/template/SequenciaTemplate.java	2026-11-02 14:59:44.200227161 -0300
@@ -0,0 +1,96 @@
+package com.umc.menteup.template;
+
+import com.umc.menteup.dto.AlternativaResponse;
+import com.umc.menteup.dto.PerguntaResponse;
+import com.umc.menteup.dto.SalvarRespostaRequest;
+import com.umc.menteup.exception.ApiException;
+import com.umc.menteup.model.Alternativa;
+import com.umc.menteup.model.Atividade;
+import com.umc.menteup.model.Pergunta;
+import com.umc.menteup.model.RespostaAtividade;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Random;
+
+///Base dos templates em que o aluno responde com uma lista de alternativas em ordem (ordenação e lacunas)
+public abstract class SequenciaTemplate implements TemplateAtividade {
+
+    ///Quantos itens a resposta do aluno deve ter nesta pergunta
+    protected abstract int tamanhoEsperado(Pergunta pergunta);
+
+    ///Compara a sequência escolhida pelo aluno com a sequência correta
+    protected abstract boolean sequenciaCorreta(Pergunta pergunta, List<Alternativa> sequencia);
+
+    ///O aluno recebe as alternativas de cada pergunta embaralhadas, para não revelar a ordem cadastrada
+    @Override
+    public List<PerguntaResponse> perguntasParaAluno(Atividade atividade) {
+        return atividade.getPerguntas().stream()
+                .map(p -> new PerguntaResponse(p.getId(), p.getEnunciado(), embaralhar(p)))
+                .toList();
+    }
+
+    @Override
+    public void validarResposta(Pergunta pergunta, SalvarRespostaRequest request) {
+        buscarSequencia(pergunta, request.alternativasIds());
+    }
+
+    @Override
+    public void preencherResposta(RespostaAtividade resposta, Pergunta pergunta, SalvarRespostaRequest request) {
+        buscarSequencia(pergunta, request.alternativasIds());
+        resposta.setAlternativa(null);
+        resposta.getAlternativasIds().clear();
+        resposta.getAlternativasIds().addAll(request.alternativasIds());
+    }
+
+    @Override
+    public boolean estaCorreta(Pergunta pergunta, RespostaAtividade resposta) {
+        return sequenciaCorreta(pergunta, buscarSequencia(pergunta, resposta.getAlternativasIds()));
+    }
+
+    ///Confere tamanho, repetição e se todos os ids são desta pergunta, devolvendo as alternativas na ordem do aluno
+    protected List<Alternativa> buscarSequencia(Pergunta pergunta, List<Long> alternativasIds) {
+        int esperado = tamanhoEsperado(pergunta);
+
+        if (alternativasIds == null || alternativasIds.size() != esperado) {
+            throw ApiException.requisicaoInvalida(
+                    "SEQUENCIA_INVALIDA",
+                    "A resposta da pergunta " + pergunta.getId() + " deve ter " + esperado + " itens."
+            );
+        }
+        if (new HashSet<>(alternativasIds).size() != alternativasIds.size()) {
+            throw ApiException.requisicaoInvalida(
+                    "SEQUENCIA_INVALIDA",
+                    "Um item não pode ser usado mais de uma vez na mesma resposta."
+            );
+        }
+
+        return alternativasIds.stream()
+                .map(id -> pergunta.getAlternativas().stream()
+                        .filter(a -> a.getId().equals(id))
+                        .findFirst()
+                        .orElseThrow(() -> ApiException.requisicaoInvalida(
+                                "ALTERNATIVA_INVALIDA",
+                                "A alternativa " + id + " não pertence à pergunta " + pergunta.getId() + "."
+                        )))
+                .toList();
+    }
+
+    ///Semente fixa pelo id da pergunta: a ordem não muda quando o aluno recarrega a página
+    private List<AlternativaResponse> embaralhar(Pergunta pergunta) {
+        List<AlternativaResponse> cadastradas = pergunta.getAlternativas().stream()
+                .map(a -> new AlternativaResponse(a.getId(), a.getTexto()))
+                .toList();
+
+        List<AlternativaResponse> embaralhadas = new ArrayList<>(cadastradas);
+        Collections.shuffle(embaralhadas, new Random(pergunta.getId() == null ? 0L : pergunta.getId()));
+
+        ///Se o embaralhamento cair na mesma ordem do cadastro, desloca uma posição
+        if (embaralhadas.size() > 1 && embaralhadas.equals(cadastradas)) {
+            Collections.rotate(embaralhadas, 1);
+        }
+        return List.copyOf(embaralhadas);
+    }
+}
