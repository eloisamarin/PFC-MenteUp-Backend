--- ../orig/src/main/java/com/umc/menteup/template/QuizTemplate.java	1969-12-31 21:00:00.000000000 -0300
+++ src/main/java/com/umc/menteup/template/QuizTemplate.java	2026-11-01 22:30:25.255508455 -0300
@@ -0,0 +1,56 @@
+package com.umc.menteup.template;
+
+import com.umc.menteup.dto.SalvarRespostaRequest;
+import com.umc.menteup.exception.ApiException;
+import com.umc.menteup.model.Alternativa;
+import com.umc.menteup.model.Pergunta;
+import com.umc.menteup.model.RespostaAtividade;
+import com.umc.menteup.model.TipoAtividade;
+import org.springframework.stereotype.Component;
+
+/**
+ * Quiz clássico: cada pergunta tem N alternativas e o aluno escolhe uma.
+ * A resposta está correta quando a alternativa escolhida está marcada como correta.
+ */
+@Component
+public class QuizTemplate implements TemplateAtividade {
+
+    @Override
+    public TipoAtividade tipo() {
+        return TipoAtividade.QUIZ;
+    }
+
+    @Override
+    public void validarResposta(Pergunta pergunta, SalvarRespostaRequest request) {
+        buscarAlternativa(pergunta, request.alternativaId(), "A alternativa não pertence a esta perguta.");
+    }
+
+    @Override
+    public void preencherResposta(RespostaAtividade resposta, Pergunta pergunta, SalvarRespostaRequest request) {
+        resposta.setAlternativa(
+                buscarAlternativa(pergunta, request.alternativaId(), "A alternativa não pertence a esta perguta.")
+        );
+    }
+
+    @Override
+    public boolean estaCorreta(Pergunta pergunta, RespostaAtividade resposta) {
+        Long alternativaId = resposta.getAlternativa().getId();
+
+        Alternativa alternativa = buscarAlternativa(
+                pergunta,
+                alternativaId,
+                "A alternativa" + alternativaId + "não pertence à pergunta" + pergunta.getId()
+        );
+
+        return Boolean.TRUE.equals(alternativa.getCorreta());
+    }
+
+    /** Busca a alternativa dentro da própria pergunta; reaproveitável por templates de escolha única. */
+    protected Alternativa buscarAlternativa(Pergunta pergunta, Long alternativaId, String mensagemErro) {
+        return pergunta.getAlternativas()
+                .stream()
+                .filter(a -> a.getId().equals(alternativaId))
+                .findFirst()
+                .orElseThrow(() -> ApiException.requisicaoInvalida("ALTERNATIVA_INVALIDA", mensagemErro));
+    }
+}
diff -ruN --strip-trailing-cr ../orig/src/main/java/com/umc/menteup/template/TemplateAtividade.java src/main/java/com/umc/menteup/template/TemplateAtividade.java
--- ../orig/src/main/java/com/umc/menteup/template/TemplateAtividade.java	1969-12-31 21:00:00.000000000 -0300
+++ src/main/java/com/umc/menteup/template/TemplateAtividade.java	2026-11-01 22:30:25.255891570 -0300
@@ -0,0 +1,39 @@
+package com.umc.menteup.template;
+
+import com.umc.menteup.dto.PerguntaRequest;
+import com.umc.menteup.dto.SalvarRespostaRequest;
+import com.umc.menteup.model.Pergunta;
+import com.umc.menteup.model.RespostaAtividade;
+import com.umc.menteup.model.TipoAtividade;
+
+/**
+ * Estratégia de um tipo de atividade (quiz, verdadeiro/falso, associação...).
+ *
+ * Os services cuidam do fluxo comum (usuário, matrícula, status, progresso,
+ * pontuação, logs) e delegam para o template apenas o que muda de um formato
+ * para outro: como validar as perguntas criadas, como registrar a resposta do
+ * aluno e como saber se ela está correta.
+ */
+public interface TemplateAtividade {
+
+    TipoAtividade tipo();
+
+    /** Valida uma pergunta enviada pelo professor ao cadastrar o questionário. */
+    default void validarCriacao(PerguntaRequest pergunta) {
+    }
+
+    /**
+     * Valida a resposta enviada pelo aluno para uma pergunta da atividade.
+     * Deve lançar {@link com.umc.menteup.exception.ApiException} quando inválida.
+     */
+    void validarResposta(Pergunta pergunta, SalvarRespostaRequest request);
+
+    /** Copia a resposta (já validada) para a entidade que será persistida no progresso. */
+    void preencherResposta(RespostaAtividade resposta, Pergunta pergunta, SalvarRespostaRequest request);
+
+    /**
+     * Corrige a resposta salva no progresso.
+     * Deve lançar {@link com.umc.menteup.exception.ApiException} se a resposta não pertencer à pergunta.
+     */
+    boolean estaCorreta(Pergunta pergunta, RespostaAtividade resposta);
+}
diff -ruN --strip-trailing-cr ../orig/src/main/java/com/umc/menteup/template/TemplateResolver.java src/main/java/com/umc/menteup/template/TemplateResolver.java
--- ../orig/src/main/java/com/umc/menteup/template/TemplateResolver.java	1969-12-31 21:00:00.000000000 -0300
+++ src/main/java/com/umc/menteup/template/TemplateResolver.java	2026-11-01 22:30:25.255146145 -0300
@@ -0,0 +1,45 @@
+package com.umc.menteup.template;
+
+import com.umc.menteup.exception.ApiException;
+import com.umc.menteup.model.Atividade;
+import com.umc.menteup.model.TipoAtividade;
+import org.springframework.stereotype.Component;
+
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Localiza o {@link TemplateAtividade} de cada tipo.
+ * O Spring injeta todas as implementações anotadas com @Component; para criar
+ * um novo tipo basta adicionar uma nova classe, sem mexer nos services.
+ */
+@Component
+public class TemplateResolver {
+
+    private final Map<TipoAtividade, TemplateAtividade> templates = new EnumMap<>(TipoAtividade.class);
+
+    public TemplateResolver(List<TemplateAtividade> implementacoes) {
+        for (TemplateAtividade template : implementacoes) {
+            if (templates.put(template.tipo(), template) != null) {
+                throw new IllegalStateException("Mais de um template registrado para o tipo " + template.tipo());
+            }
+        }
+    }
+
+    public TemplateAtividade resolver(Atividade atividade) {
+        return resolver(atividade.getTipo());
+    }
+
+    public TemplateAtividade resolver(TipoAtividade tipo) {
+        TemplateAtividade template = templates.get(TipoAtividade.ouPadrao(tipo));
+
+        if (template == null) {
+            throw ApiException.requisicaoInvalida(
+                    "TIPO_ATIVIDADE_NAO_SUPORTADO",
+                    "O tipo de atividade " + tipo + " ainda não está disponível."
+            );
+        }
+        return template;
+    }
+}
