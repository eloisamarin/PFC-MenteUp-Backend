+package com.umc.menteup.model;
+
+/**
+ * Template (formato) de uma atividade, escolhido pelo professor na etapa 2 da criação.
+ * Cada valor tem uma implementação de {@link com.umc.menteup.template.TemplateAtividade}
+ * que sabe validar, registrar e corrigir as respostas daquele formato.
+ */
+public enum TipoAtividade {
+    QUIZ,
+    VERDADEIRO_FALSO,
+    ASSOCIACAO,
+    ORDENACAO,
+    LACUNAS;
+
+    /** Atividades antigas (criadas antes desta coluna existir) são tratadas como QUIZ. */
+    public static TipoAtividade ouPadrao(TipoAtividade tipo) {
+        return tipo == null ? QUIZ : tipo;
+    }
+}
